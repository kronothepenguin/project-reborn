package main

import (
	"log"
	"net/http"
	"net/http/httputil"
	"net/url"

	"github.com/kronothepenguin/project-reborn/packages/astro"
	"github.com/kronothepenguin/project-reborn/packages/{{.Name}}"
	"github.com/kronothepenguin/project-reborn/packages/store"
)

func main() {
	baseURL, err := url.Parse("http://localhost:{{.AstroPort}}")
	if err != nil {
		panic(err)
	}
	resolver := astro.MakeServerResolver(baseURL)
	proxy := httputil.NewSingleHostReverseProxy(baseURL)

	db := store.FromConfig()

	c := {{.Name}}.New(db,
		{{.Name}}.WithResolver(resolver),
		{{.Name}}.WithStatic(proxy),
	)

	mux := http.NewServeMux()
	c.Mount(mux)

	server := http.Server{
		Addr:    "localhost:{{.AppPort}}",
		Handler: mux,
	}

	log.Println("{{.Name}} dev on http://" + server.Addr)
	log.Fatalln(server.ListenAndServe())
}
