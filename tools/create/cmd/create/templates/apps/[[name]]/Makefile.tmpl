.PHONY: install dev web stop

install:
	$(MAKE) -C ../../packages/{{.Name}} install
	mkdir -p tmp

# air runs from the repository root, so the runner reads the root config.json.
dev:
	cd ../../packages/{{.Name}} && pnpm astro dev --background
	cd ../.. && go tool air -c apps/{{.Name}}/.air.toml

web:
	pnpm --filter @project-reborn/{{.Name}} dev

stop:
	cd ../../packages/{{.Name}} && pnpm astro dev stop
