package {{.Name}}

import (
	"database/sql"
	"embed"
	"net/http"

	"github.com/kronothepenguin/project-reborn/packages/astro"
	"github.com/kronothepenguin/project-reborn/packages/{{.Name}}/internal/router"
	"github.com/kronothepenguin/project-reborn/packages/store"
)

//go:embed dist/*
var DistFS embed.FS

type {{.Type}} struct {
	db      *sql.DB
	static  http.Handler
	resolve astro.Resolver
}

type Option func(*{{.Type}})

func New(db *sql.DB, opts ...Option) *{{.Type}} {
	c := &{{.Type}}{db: db}
	for _, opt := range opts {
		opt(c)
	}
	return c
}

func (c *{{.Type}}) Mount(mux *http.ServeMux) {
	r := router.New(router.Deps{Resolver: c.resolve, DB: c.db, Queries: store.New(c.db)})

	mux.HandleFunc("GET /{$}", r.HandleIndexView)

	mux.Handle("/", c.static)
}

func WithStatic(h http.Handler) Option {
	return func(c *{{.Type}}) {
		c.static = h
	}
}

func WithResolver(r astro.Resolver) Option {
	return func(c *{{.Type}}) {
		c.resolve = r
	}
}
