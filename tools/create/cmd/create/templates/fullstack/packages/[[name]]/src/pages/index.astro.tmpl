---
import { Paper } from "@project-reborn/components";
import Counter from "../components/counter.svelte";
import Document from "../layouts/document.astro";
---

<Document title="{{.Name}}">
  <Paper>
    <main class="space-y-2 p-6">
      <h1 class="text-3xl font-bold tracking-tight">{{.Name}}</h1>
      <p class="text-sm text-zinc-600">
        Injected by the Go handler: <span class="font-mono">[[.Title]]</span>
      </p>
      <Counter client:only="svelte" />
    </main>
  </Paper>
</Document>
