package router

import (
	"database/sql"

	"github.com/kronothepenguin/project-reborn/packages/store"
)

// Deps are what the handlers share: what New received and what the package built from it.
type Deps struct {
	DB      *sql.DB
	Queries *store.Queries
}

type Router struct {
	deps Deps
}

func New(deps Deps) *Router {
	return &Router{deps: deps}
}
