---
import HelpWindow from "../components/help/help-window.svelte";
import Document from "./document.astro";

// The Help Tool's small window: Holo's iot/header.php and iot/footer.php around
// the portlet of iot/go.php, which holds the page. Its logo is the site's, the
// same picture as Holo's habbo_logo_uk.gif.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Document title={title}>
  <HelpWindow client:only="svelte" />
  <div class="min-h-screen bg-cyan-950 text-[12px] leading-[normal]">
    <table class="w-[720px]">
      <tr>
        <td class="h-[77px] w-2 bg-[url(/iot/content3/images/process/top_left.gif)] bg-no-repeat">&nbsp;</td>
        <td class="bg-[url(/iot/content3/images/process/top_mid.gif)] bg-repeat-x align-top">
          <div class="h-[77px] pt-2.5 pl-[27px]"><img src="/habbo.png" alt="Habbo Hotel" width="111" height="54" /></div>
        </td>
        <td class="h-[77px] w-[3px] bg-[url(/iot/content3/images/process/top_header_left.gif)] bg-no-repeat"></td>
        <td class="h-[77px] bg-[url(/iot/content3/images/process/top_header_mid.gif)] bg-repeat-x">
          <div class="h-[74px] pt-[31px] pl-1 font-bold text-white uppercase">[[ .ShortName ]] Help Tool</div>
        </td>
        <td class="h-[77px] bg-[url(/iot/content3/images/process/top_header_mid.gif)] bg-repeat-x pt-[23px] text-right align-top"></td>
        <td class="h-[77px] w-[26px] bg-[url(/iot/content3/images/process/top_right.gif)] bg-no-repeat">&nbsp;</td>
      </tr>
    </table>
    <div class="w-[720px] bg-slate-500 bg-[url(/iot/content3/images/process/content_mid.gif)] bg-repeat-y">
      <div class="h-1"></div>
      <div class="h-[18px] pl-3">&nbsp;</div>
      <div class="h-[25px] bg-[url(/iot/content3/images/process/content_box_top.gif)] bg-no-repeat"></div>
      <div class="overflow-hidden bg-white bg-[url(/iot/content3/images/process/content_box_mid.gif)] bg-repeat-y pt-1.5 pr-2 pb-1 pl-3.5">
        <div class="mt-2.5 mr-[50px] mb-5 ml-2.5"><slot /></div>
      </div>
      <div class="h-2.5 bg-[url(/iot/content3/images/process/content_box_btm.gif)] bg-no-repeat"></div>
    </div>
    <footer class="w-[720px] pb-[5px] text-slate-400">
      <div class="h-2.5 bg-[url(/iot/content3/images/process/content_legal_top.gif)] bg-no-repeat text-[8px]">&nbsp;</div>
      <div class="bg-white bg-[url(/iot/content3/images/process/content_legal_mid.gif)] bg-repeat-y pt-1.5 pr-2 pb-1 pl-2 text-center text-[9px]">
        Powered by Project Reborn &copy;<br />HABBO is a registered trademark of Sulake Corporation Oy. All rights reserved to
        their respective owners.
      </div>
      <div class="h-3.5 bg-[url(/iot/content3/images/process/content_legal_btm.gif)] bg-no-repeat">&nbsp;</div>
    </footer>
  </div>
</Document>
