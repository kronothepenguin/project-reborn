---
import { Link } from "@project-reborn/components";
import background from "../assets/community/bg.png";
import OpenClient from "../components/client/open-client.svelte";
import ClosedAlert from "../components/header/closed-alert.astro";
import EnterHotel from "../components/header/enter-hotel.astro";
import HabboSearch from "../components/header/habbo-search.astro";
import HotelStatus from "../components/header/hotel-status.astro";
import MainTabs from "../components/header/main-tabs.astro";
import MiniLogin from "../components/header/mini-login.astro";
import MyGroups from "../components/header/my-groups.svelte";
import SubTabs, { type CommunityTab } from "../components/header/sub-tabs.astro";
import UserMenu from "../components/header/user-menu.astro";
import OpenHelp from "../components/help/open-help.svelte";
import Document from "./document.astro";

interface Props {
  title: string;
  tab: CommunityTab;
  sub: string;
  // wide is Holo's myhabbo pages, the homes and the groups: the
  // sub-navigation runs the page's width and the footer is centred under it.
  wide?: boolean;
}

const { title, tab, sub, wide = false } = Astro.props;

// Holo's community page: the 930px page, centred, under a 104px header whose
// parts stand where Holo's stood: the logo at 16px from the top, the white bar
// at 190px, the users online at 781px and the main tabs on the header's black
// bottom line. The sub-navigation is Holo's 761px bar under the tabs, or its
// 928px bar on a wide page, with the items 12px further in.
---

<Document
  title={title}
  description="[[ .Name ]] is a virtual world where you can meet and make friends."
  keywords="[[ .Name ]],[[ .ShortName ]],virtual world,play games,enter competitions,make friends"
>
  <div
    class="min-h-screen min-w-[950px] bg-taupe-200 text-xs"
    style={`background-image: url(${background.src})`}
  >
    <header class="border-b-2 border-black bg-sky-200 px-2.5">
      <div class="relative mx-auto h-[102px] w-[930px]">
        <a href="/" class="absolute top-4 left-0 block h-[42px] w-[111px] overflow-hidden">
          <img src="/habbo.png" alt="Habbo Hotel" width="111" height="54" />
        </a>

        <div class="absolute top-0 left-[190px] w-[572px]">
          [[ if .SignedIn ]]
          <div class="flex h-7 items-center justify-end rounded-b bg-white px-3">
            <UserMenu />
          </div>
          <div class="flex items-start justify-between pt-2 pr-0 pl-3">
            [[ if .Online ]]<EnterHotel />[[ else ]]<HotelStatus />[[ end ]]
            <HabboSearch />
          </div>
          [[ else ]]
          <div class="pt-4 pl-3">
            [[ if .Online ]]<EnterHotel />[[ else ]]<HotelStatus />[[ end ]]
          </div>
          <MiniLogin />
          [[ end ]]
        </div>

        <div class="absolute top-0 left-[201px] z-10">
          <MyGroups client:only="svelte" signedIn="[[ .SignedIn ]]" />
        </div>
        <OpenHelp client:only="svelte" />
        <OpenClient client:only="svelte" />

        <p class="absolute top-[15px] left-[781px] w-[110px] rounded-lg bg-white px-5.5 py-4.5 text-center">
          [[ .OnlineCount ]] users online now
        </p>

        <div class="absolute -bottom-0.5 left-0">
          <MainTabs active={tab} />
        </div>
      </div>
    </header>

    <div class="px-2.5">
      <nav class="mx-auto w-[930px]">
        <div
          class:list={[
            "ml-px rounded-b-md border-x border-b-[3px] border-black/20 bg-white bg-clip-padding pb-1.5",
            wide ? "w-[928px] px-3" : "w-[761px]",
          ]}
        >
          <SubTabs tab={tab} active={sub} />
        </div>
      </nav>

      <ClosedAlert />

      <main class="mx-auto w-[930px] pt-1">
        <slot />
      </main>

      <footer class:list={["mx-auto w-[930px] pb-3 pl-1 text-center text-xs text-neutral-500", wide ? "pr-1" : "pr-[170px]"]}>
        <p class="pt-1.5"><Link variant="black" href="/">Homepage</Link> | <Link variant="black" href="/disclaimer">Terms of Service</Link> | <Link variant="black" href="/privacy">Privacy Policy</Link></p>
        <p class="pt-1.5">
          Powered by Project Reborn &copy;<br />HABBO is a registered trademark
          of Sulake Corporation. All rights reserved to their respective
          owner(s).
        </p>
      </footer>

      <ClosedAlert />
    </div>
  </div>
</Document>
