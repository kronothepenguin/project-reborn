---
import { Link } from "@project-reborn/components";
import background from "../assets/community/bg.png";
import OpenClient from "../components/client/open-client.svelte";
import ClosedAlert from "../components/header/closed-alert.astro";
import EnterHotel from "../components/header/enter-hotel.astro";
import HabboSearch from "../components/header/habbo-search.astro";
import HotelStatus from "../components/header/hotel-status.astro";
import MainTabs from "../components/header/main-tabs.astro";
import MiniLogin from "../components/header/mini-login.astro";
import MyGroups from "../components/header/my-groups.svelte";
import SubTabs, { type CommunityTab } from "../components/header/sub-tabs.astro";
import UserMenu from "../components/header/user-menu.astro";
import OpenHelp from "../components/help/open-help.svelte";
import Document from "./document.astro";

interface Props {
  title: string;
  tab: CommunityTab;
  sub: string;
  // fluid lays the page out in flexbox for every screen, as the pages reviewed
  // beside Holo's; the others keep the 1240px page until they are reviewed.
  fluid?: boolean;
}

const { title, tab, sub, fluid = false } = Astro.props;

// Holo's 930px page at 16/11: 1352px at most, centred, and as wide as the
// screen below that. The header, the sub-navigation and the footer end where
// Holo's did, at the second column's right edge, 82% of the page; the third
// column's strip holds the users online.
const page = "mx-auto w-full max-w-338 px-2 md:px-3.5";
const left = "lg:w-[82%]";
---

<Document
  title={title}
  description="[[ .Name ]] is a virtual world where you can meet and make friends."
  keywords="[[ .Name ]],[[ .ShortName ]],virtual world,play games,enter competitions,make friends"
>
  <div
    class:list={["min-h-screen bg-taupe-200 text-base", !fluid && "min-w-[1268px]"]}
    style={`background-image: url(${background.src})`}
  >
    <header class="border-b-2 border-black bg-sky-200">
      <div class:list={["relative", page]}>
        <div class="flex items-start lg:h-27.5">
          <div class:list={["flex min-w-0 flex-1 flex-wrap items-start md:flex-nowrap lg:flex-none", left]}>
            <div class="mt-3 shrink-0 md:mt-6 md:mb-6.5 lg:w-[25%]">
              <a href="/" class="block h-[42px] w-[111px] overflow-hidden">
                <img src="/habbo.png" alt="Habbo Hotel" width="111" height="54" />
              </a>
            </div>

            <div class="relative order-last w-full min-w-0 pt-3 md:order-none md:ml-4 md:w-auto md:flex-1 md:pt-0 lg:ml-0">
              [[ if .SignedIn ]]
              <div class="flex h-10 items-center justify-end rounded-bl bg-white pr-4 pl-32">
                <UserMenu />
              </div>
              <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 pt-3 pb-3 md:pl-4">
                [[ if .Online ]]<EnterHotel />[[ else ]]<HotelStatus />[[ end ]]
                <HabboSearch />
              </div>
              [[ else ]]
              <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3 pb-3 md:pt-2.5">
                <div class="md:pt-7 md:pl-4">
                  [[ if .Online ]]<EnterHotel />[[ else ]]<HotelStatus />[[ end ]]
                </div>
                <MiniLogin />
              </div>
              [[ end ]]
              <div class="absolute top-4 left-0 z-10 md:top-1 md:left-4">
                <MyGroups client:only="svelte" signedIn="[[ .SignedIn ]]" />
              </div>
            </div>
          </div>

          <div class="absolute top-3 right-2 md:static md:mt-5.5 md:ml-4 md:shrink-0 lg:ml-[2%] lg:w-[14%]">
            <p class="rounded bg-white px-2.5 py-1.5 text-center text-sm md:p-3.5">
              [[ .OnlineCount ]] users online now
            </p>
          </div>
        </div>
        <OpenHelp client:only="svelte" />
        <OpenClient client:only="svelte" />

        <div class="-mb-0.5">
          <MainTabs active={tab} />
        </div>
      </div>
    </header>

    <div class={page}>
      <nav class={left}>
        <div class="rounded-b border-x border-b-[3px] border-black/20 bg-white bg-clip-padding pb-2">
          <SubTabs tab={tab} active={sub} />
        </div>
      </nav>

      <ClosedAlert />

      <main class:list={["pt-2.5", fluid ? "pb-2.5" : "mx-auto w-310"]}>
        <slot />
      </main>

      <footer class:list={["pb-4 text-center text-xs text-neutral-500", left]}>
        <p class="pt-2"><Link variant="black" href="/">Homepage</Link> | <Link variant="black" href="/disclaimer">Terms of Service</Link> | <Link variant="black" href="/privacy">Privacy Policy</Link></p>
        <p class="pt-2">
          Powered by Project Reborn &copy;<br />HABBO is a registered trademark
          of Sulake Corporation. All rights reserved to their respective
          owner(s).
        </p>
      </footer>

      <ClosedAlert />
    </div>
  </div>
</Document>
