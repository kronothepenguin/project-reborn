---
import Paper from "../components/paper.astro";
import Document from "./document.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<Document title={title}>
  <div class="flex min-h-screen items-center justify-center p-2">
    <Paper class="w-full max-w-189 rounded-md border border-mist-400 p-4 shadow-[0_3px_0_var(--color-mist-400)]">
      <header class="flex items-center justify-between gap-2 p-2">
        <img src="/logo.svg" alt="Habbo Hotel" width="180" height="40" />
        <p class="text-sm">
          <span class="font-bold">[[ .Online ]]</span>
          <span class="text-orange-500">users online now</span>
        </p>
        [[ if .IsUp ]]
        <p class="flex items-center gap-1.5 text-sm font-bold text-green-600">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-green-500"></span>
          Hotel online
        </p>
        [[ else ]]
        <p class="flex items-center gap-1.5 text-sm font-bold text-red-600">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-red-500"></span>
          Hotel offline
        </p>
        [[ end ]]
      </header>

      <slot />

      <footer class="border-t border-mist-400 p-2 text-center text-xs">
        <p>
          <a href="/" class="text-sky-700 underline">
            Homepage
          </a>
          <span class="text-mist-400">|</span>
          <a href="[[ .TermsURL ]]" class="text-sky-700 underline">
            Terms of Service
          </a>
          <span class="text-mist-400">|</span>
          <a href="[[ .PrivacyURL ]]" class="text-sky-700 underline">
            Privacy Policy
          </a>
        </p>
        <p class="mt-1 text-neutral-600">
          Powered by ProjectReborn &copy; 2008 Meth0d &amp; Parts by Yifan,
          sisija.
          <br />
          HABBO is a registered trademark of Sulake Corporation. All rights
          reserved to their respective owner(s).
        </p>
      </footer>
    </Paper>
  </div>
</Document>
