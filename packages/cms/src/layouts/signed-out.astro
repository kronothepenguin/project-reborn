---
import { Link, Paper } from "@project-reborn/components";
import offlineGif from "../assets/offline.gif";
import onlineGif from "../assets/online.gif";
import Document from "./document.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;

// Holo's process page: a 758px box 12px from the top, at the left of a
// centred 766px container, with 21px of
// padding at each side; the logo 16px from its top and the counts on one row
// under it, as Holo's 70px header; then the page and the footer.
---

<Document
  title={title}
  description="[[ .Name ]] is a virtual world where you can meet and make friends."
  keywords="[[ .ShortName ]],[[ .Name ]],virtual world,play games,enter competitions,make friends"
>
  <div class="min-w-[766px] pb-2 text-xs">
    <div class="mx-auto mt-3 w-[766px] pr-2">
      <Paper>
        <div class="px-5 pt-1">
          <header class="relative h-[70px]">
            <a href="/" class="absolute top-4 left-0 block"><img src="/habbo.png" alt="Habbo Hotel" width="111" height="54" /></a>
            <ul class="absolute top-14 left-0 flex text-orange-500">
              <li class="flex w-[395px] items-center justify-end gap-1">
                <span class="font-bold text-black">
                  [[ if .Online ]] [[ .OnlineCount ]] [[ else ]] 0 [[ end ]]
                </span>
                <span>users online now</span>
                [[ if .Online ]]
                <img
                  src={onlineGif.src}
                  width={onlineGif.width}
                  height={onlineGif.height}
                />
                [[ else ]]
                <img
                  src={offlineGif.src}
                  width={offlineGif.width}
                  height={offlineGif.height}
                />
                [[ end ]]
              </li>
              <li class="flex w-[310px] items-center justify-end gap-1">
                <span class="font-bold text-black">[[ .RegisteredUsers ]]</span>
                <span>registered users</span>
              </li>
            </ul>
          </header>

          <slot />

          <footer class="pt-4 pb-3 pl-1 text-center text-xs text-neutral-500">
            <p class="pt-1.5"><Link variant="black" href="/">Homepage</Link> | <Link variant="black" href="/disclaimer">Terms of Service</Link> | <Link variant="black" href="/privacy">Privacy Policy</Link>[[ if .Staff ]] | <Link variant="black" href="[[ .HousekeepingURL ]]"><b>Housekeeping</b></Link>[[ end ]]</p>
            <p class="pt-1.5">
              Powered by Project Reborn &copy;<br />HABBO is a registered
              trademark of Sulake Corporation. All rights reserved to their
              respective owner(s).
            </p>
          </footer>
        </div>
      </Paper>
    </div>
  </div>
</Document>
