---
import { Button, Icon } from "@project-reborn/components";
import MypageBox from "./mypage-box.astro";
import Note from "./note.astro";
import GroupInfoWidget from "./widgets/group-info-widget.astro";
import GroupsWidget from "./widgets/groups-widget.astro";
import MembersWidget from "./widgets/members-widget.astro";
import ProfileWidget from "./widgets/profile-widget.astro";

// editing is Holo's edit mode, where the editor island takes over the playground
// and its toolbar sits in the slot. A group's page gives its own header.
interface Props {
  editing?: boolean;
}

const { editing = false } = Astro.props;

// The box stands under the community layout's sub-navigation, as wide and at its
// left edge, as the forum's does. The canvas is 752px for everyone, 3px in, with
// Holo's dotted frames in edit drawn as outlines, so the canvas keeps its place.
---

<div class="ml-px w-[761px]">
  <MypageBox data-mode={editing ? "edit" : "view"}>
    <Fragment slot="header">
      <slot name="header">
        {!editing && (
          <Fragment>
            [[ if .CanEdit ]]
            <div class="mb-1.5 ml-2.5">
              <Button
                variant="dark"
                size="compact"
                href="/home/[[ .OwnerPath ]]/edit"
              >
                <span class="flex items-center gap-1">
                  <Icon variant="edit" />
                  Edit
                </span>
              </Button>
            </div>
            [[ end ]]
          </Fragment>
        )}
        <h2 class="mr-2 pt-1 pl-2.5 text-sm font-bold text-sky-500">
          [[ .Owner ]]
        </h2>
      </slot>
    </Fragment>
    <div>
      <slot />
      <div
        id="mypage-bg"
        class:list={[
          "relative px-[3px]",
          editing && "py-0.5 outline outline-dotted outline-white -outline-offset-1",
        ]}
        style="background-image: url('[[ .Background ]]')"
        data-background="[[ .BackgroundID ]]"
      >
        <div
          id="playground"
          class:list={[
            "relative h-[1360px] w-[752px] overflow-hidden",
            editing && "outline outline-dotted outline-black",
          ]}
        >
          [[ range .Items ]] [[ if eq .Kind "sticker" ]]
          <div
            class="movable sticker absolute"
            id="sticker-[[ .ID ]]"
            style="left: [[ .X ]]px; --x: [[ .X ]]px; top: [[ .Y ]]px; z-index: [[ .Z ]]"
            data-foreign={editing ? "[[ .Foreign ]]" : undefined}
          >
            <img src="[[ .Image ]]" alt="" />
          </div>
          [[ else if eq .Kind "note" ]]
          <Note editing={editing} />
          [[ else if eq .Widget "profile" ]]
          <ProfileWidget />
          [[ else if eq .Widget "group_info" ]]
          <GroupInfoWidget />
          [[ else if eq .Widget "members" ]]
          <MembersWidget />
          [[ else if eq .Widget "groups" ]]
          <GroupsWidget />
          [[ end ]] [[ end ]]
        </div>
      </div>
    </div>
  </MypageBox>
</div>
