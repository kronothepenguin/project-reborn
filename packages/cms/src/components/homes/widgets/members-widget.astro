---
import { Avatar } from "@project-reborn/components";

// The Group Members widget inside [[ range .Items ]], so . is the item and $ the
// page. Holo's tiles took their background from Habbo's CDN, which is gone, so
// they show the dashed border alone, as Holo's do now.
---

<div
  class="movable widget members-widget absolute"
  id="widget-[[ .ID ]]"
  style="left: [[ .X ]]px; top: [[ .Y ]]px; z-index: [[ .Z ]]"
>
  <div data-widget-skin="[[ .Skin ]]">
    <div class="widget-corner" id="widget-[[ .ID ]]-handle">
      <div class="widget-headline">
        <h3>
          <span class="header-left">&nbsp;</span><span class="header-middle"
            >Members of this group (<span id="avatar-list-size">[[ $.Info.Members ]]</span>)</span
          ><span class="header-right">&nbsp;</span>
        </h3>
      </div>
    </div>
    <div class="widget-body">
      <div class="widget-content">
        <br class="clear-both" />
        <div class="h-[196px] overflow-auto">
          <ul class="avatar-widget-list m-0 list-none pl-0">
            [[ range $.Members ]]
            <li
              title="[[ .Name ]]"
              class="float-left mx-[3px] my-0.5 h-14 w-[125px] overflow-hidden border border-dashed border-white text-[10px] whitespace-nowrap hover:border-solid"
            >
              <div class="float-left mr-0.5">
                <Avatar
                  imagingUrl="[[ $.ImagingURL ]]"
                  figure="[[ .Figure ]]"
                  size="s"
                  direction={2}
                  headDirection={2}
                  gesture="sml"
                />
              </div>
              <h4 class="m-0 overflow-hidden p-0.5 text-[10px] font-bold"><a href="/home?name=[[ .Name ]]">[[ .Name ]]</a></h4>
              <p class="m-0 overflow-hidden p-0.5 italic">[[ .Created ]]</p>
              <p class="m-0 flex overflow-hidden p-0.5">
                [[ if .Owner ]]<img class="mr-[5px]" src="/web-gallery/images/groups/owner_icon.gif" alt="Owner" title="Owner" />[[ else if .Admin ]]<img
                  class="mr-[5px]"
                  src="/web-gallery/images/groups/administrator_icon.gif"
                  alt="Administrator"
                  title="Administrator"
                />[[ end ]]
                [[ if .Favourite ]]<span
                  role="img"
                  aria-label="Favorite"
                  title="Favorite"
                  class="mr-[5px] inline-block h-4 w-4 bg-[url(/web-gallery/v2/images/info_icons.png)] bg-position-[100%_-433px] bg-no-repeat"
                ></span>[[ end ]]
              </p>
            </li>
            [[ end ]]
          </ul>
        </div>
        <div class="clear-both"></div>
      </div>
    </div>
  </div>
</div>
