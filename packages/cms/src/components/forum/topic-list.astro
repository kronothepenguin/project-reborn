---
import { Button, Icon } from "@project-reborn/components";
import PageNumbers from "./page-numbers.astro";

// forum.php's list of threads, a row per thread between the page links. Every
// link of Holo's board was underlined.
---

<div class="flow-root pt-2 pl-3.5">
  [[ if .SignedIn ]]
  <span class="float-left mb-1.5">
    <Button id="newtopic-upper">
      <span class="flex items-center gap-1"><Icon variant="newtopic" />New Thread</span>
    </Button>
  </span>
  [[ end ]]
  <PageNumbers base="/forum?page=" />
</div>
<table class="w-full border-collapse" id="group-topiclist-list">
  <tr class="text-olive-500">
    <td class="py-2 pr-1 pl-3.5">Topic</td>
    <td class="py-2 pr-1 pl-3.5">Last post</td>
    <td class="px-1 py-2 text-center">Replies</td>
    <td class="px-1 py-2 text-center">Views</td>
  </tr>
  [[ if .Empty ]]
  <tr>
    <td class="p-1 pl-3.5 align-top">No threads to display.</td>
  </tr>
  [[ end ]] [[ range .Threads ]] [[ $thread := .ID ]]
  <tr class="h-[53px] [[ if .Even ]] bg-olive-200 [[ end ]]">
    <td class="w-[446px] p-1 pl-3.5 align-top">
      <div>
        [[ if .Sticky ]]<a
          class="bg-[url(/web-gallery/v2/images/discussions/forum_icons.png)] bg-position-[0_0] bg-no-repeat py-0.5 pl-[21px] text-xs leading-4 font-bold text-black underline"
          href="/forum/threads/[[ .ID ]]">[[ .Title ]]</a
        >[[ else ]]<a class="text-xs text-black underline" href="/forum/threads/[[ .ID ]]">[[ .Title ]]</a>[[ end ]]
        [[ if .Locked ]]&nbsp;<span
          ><img class="inline" src="/web-gallery/images/groups/status_closed.gif" title="Closed Thread" alt="Closed Thread" /></span
        >[[ end ]]&nbsp;(page [[ range .Pages ]]<a class="text-black underline" href="/forum/threads/[[ $thread ]]?page=[[ . ]]"
          >[[ . ]]</a
        > [[ end ]])
        <br />
        <span
          >[[ if .OpenerArchived ]]archived[[ else ]]<a class="text-sky-500 underline" href="/home?name=[[ .Opener ]]">[[ .Opener ]]</a
          >[[ end ]]</span
        >&nbsp;<span class="text-neutral-500">[[ .Date ]]</span>{" "}<span class="text-neutral-500">([[ .Time ]])</span>
      </div>
    </td>
    <td class="w-[166px] border-l border-olive-300 p-1 pl-3.5 align-top">
      <a class="text-neutral-500 underline" href="/forum/threads/[[ .ID ]]?page=[[ .LastPage ]]#page-bottom"
        ><span>[[ .LastDate ]]</span>{" "}<span>([[ .LastTime ]])</span></a
      ><br />
      <span>by:</span>{" "}[[ if .LastPosterArchived ]]archived[[ else ]]<a class="text-sky-500 underline" href="/home?name=[[ .LastPoster ]]"
        >[[ .LastPoster ]]</a
      >[[ end ]]&nbsp;
    </td>
    <td class="w-[73px] border-l border-olive-300 p-1 text-center align-top">[[ .Replies ]]</td>
    <td class="w-[73px] border-l border-olive-300 p-1 text-center align-top">[[ .Views ]]</td>
  </tr>
  [[ end ]]
</table>
<div class="flow-root pt-1 pb-2 pl-3.5">
  [[ if .SignedIn ]]
  <span class="float-left mb-1.5">
    <Button id="newtopic-lower">
      <span class="flex items-center gap-1"><Icon variant="newtopic" />New Thread</span>
    </Button>
  </span>
  [[ else ]] You must be logged in to reply or post new threads. [[ end ]]
  <PageNumbers base="/forum?page=" />
</div>
