---
interface Props {
  items: { label: string; href: string }[];
  active: string;
}

const { items, active } = Astro.props;

// Holo's #navi2: 12px on an 18px line, 6px from the top and 20px from the
// left; items separated by a thin line 1.3em away on each side, the selected
// one bold and black, a link underlined while pointed at.
---

<ul class="flex pt-1.5 pl-5 text-xs leading-4.5">
  {
    items.map(({ label, href }, index) => (
      <li
        class:list={[
          index < items.length - 1 && "mr-[1.3em] border-r border-gray-200 pr-[1.3em]",
          label === active && "font-bold text-black",
        ]}
      >
        {label === active ? (
          label
        ) : (
          <a class="text-blue-850 no-underline hover:underline" href={href}>
            {label}
          </a>
        )}
      </li>
    ))
  }
</ul>
