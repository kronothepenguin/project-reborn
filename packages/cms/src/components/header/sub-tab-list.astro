---
interface Props {
  items: { label: string; href: string }[];
  active: string;
}

const { items, active } = Astro.props;

// Holo's #navi2: items separated by a thin line 1.3em away on each side, the
// selected one bold and black, a link underlined while pointed at.
---

<ul class="flex flex-wrap pt-2 pr-58 pl-7 text-lg leading-6">
  {
    items.map(({ label, href }, index) => (
      <li
        class:list={[
          index < items.length - 1 && "mr-[1.3em] border-r border-gray-200 pr-[1.3em]",
          label === active && "font-bold text-black",
        ]}
      >
        {label === active ? (
          label
        ) : (
          <a class="text-blue-900 no-underline hover:underline" href={href}>
            {label}
          </a>
        )}
      </li>
    ))
  }
</ul>
