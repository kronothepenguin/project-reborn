---
interface Props {
  items: { label: string; href: string }[];
  active: string;
}

const { items, active } = Astro.props;

// Holo's #navi2: 12px on an 18px line, padding 6px 0 0 20px, at 16/11; items
// separated by a thin line 1.3em away on each side, the selected one bold and
// black, a link underlined while pointed at. On a phone the items wrap, closer.
---

<ul class="flex flex-wrap gap-y-1 px-3 pt-2 text-base leading-6 md:pr-7 md:pl-7 md:text-lg md:leading-7">
  {
    items.map(({ label, href }, index) => (
      <li
        class:list={[
          index < items.length - 1 && "mr-[0.8em] border-r border-gray-200 pr-[0.8em] md:mr-[1.3em] md:pr-[1.3em]",
          label === active && "font-bold text-black",
        ]}
      >
        {label === active ? (
          label
        ) : (
          <a class="text-blue-900 no-underline hover:underline" href={href}>
            {label}
          </a>
        )}
      </li>
    ))
  }
</ul>
