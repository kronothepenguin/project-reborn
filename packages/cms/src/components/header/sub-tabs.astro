---
import SubTabList from "./sub-tab-list.astro";

// home is a habbo's home: under Me when it is the active habbo's, as Holo's
// myprofile, and under Community otherwise, which only the page data can tell.
export type CommunityTab = "me" | "community" | "credits" | "home";

interface Props {
  tab: CommunityTab;
  active: string;
}

const { tab, active } = Astro.props;

const groups: Record<Exclude<CommunityTab, "home">, { label: string; href: string }[]> = {
  me: [
    { label: "Homepage", href: "/me" },
    { label: "My Page", href: "/home?name=[[ .Habbo ]]" },
    { label: "Account Settings", href: "/account" },
    { label: "Habbo Club", href: "/club" },
  ],
  community: [
    { label: "Community", href: "/community" },
    { label: "News", href: "/news" },
    { label: "Staff", href: "/staff" },
    { label: "Discussion Board", href: "/forum" },
    { label: "Tags", href: "/tags" },
  ],
  credits: [
    { label: "Credits", href: "/credits" },
    { label: "Habbo Club", href: "/club" },
  ],
};
---

{
  tab === "home" ? (
    <Fragment>
      [[ if .MyPage ]]
      <SubTabList items={groups.me} active="My Page" />
      [[ else ]]
      <SubTabList items={groups.community} active="" />
      [[ end ]]
    </Fragment>
  ) : (
    <SubTabList items={groups[tab]} active={active} />
  )
}
