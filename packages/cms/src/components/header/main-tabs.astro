---
import type { CommunityTab } from "./sub-tabs.astro";

interface Props {
  active: CommunityTab;
}

const { active } = Astro.props;

// Holo's tabs.png drawn in CSS, as Button draws its raised face: a 2px outline
// with stepped top corners, a darker lower half and a lighter upper half drawn
// by ::before, both lighter while pointed at. An unselected tab ends in the 2px
// black line under the header; the selected one is white down to the line it
// covers, and opens into the sub-navigation.
const tab =
  "relative isolate block h-9 max-w-96 truncate rounded-t border-2 px-7 pt-1.5 text-lg leading-6";
const raised = `${tab} border-b-black text-white before:absolute before:inset-x-0 before:top-0 before:-z-10 before:h-1/2 before:rounded-t-[2px] before:content-['']`;
const selected = `${tab} border-b-0 border-black bg-white font-bold text-black`;
const normal = `${raised} border-blue-900 bg-sky-700 before:bg-sky-600 hover:bg-sky-600 hover:before:bg-sky-400`;
const green = `${raised} border-lime-800 bg-lime-600 before:bg-lime-500 hover:bg-lime-500 hover:before:bg-lime-400`;
---

<ul class="flex items-end gap-1.5">
  [[ if .SignedIn ]]
  {
    active === "home" ? (
      <Fragment>
        [[ if .MyPage ]]
        <li>
          <strong class={selected}>[[ .Habbo ]]</strong>
        </li>
        [[ else ]]
        <li>
          <a class={normal} href="/">
            [[ .Habbo ]]
          </a>
        </li>
        [[ end ]]
      </Fragment>
    ) : active === "me" ? (
      <li>
        <strong class={selected}>[[ .Habbo ]]</strong>
      </li>
    ) : (
      <li>
        <a class={normal} href="/">
          [[ .Habbo ]]
        </a>
      </li>
    )
  }
  [[ else ]]
  <li><a class={green} href="/register">Register now!</a></li>
  [[ end ]]
  {
    active === "home" ? (
      <Fragment>
        [[ if .MyPage ]]
        <li>
          <a class={normal} href="/community">
            Community
          </a>
        </li>
        [[ else ]]
        <li>
          <strong class={selected}>Community</strong>
        </li>
        [[ end ]]
      </Fragment>
    ) : active === "community" ? (
      <li>
        <strong class={selected}>Community</strong>
      </li>
    ) : (
      <li>
        <a class={normal} href="/community">
          Community
        </a>
      </li>
    )
  }
  {
    active === "credits" ? (
      <li>
        <strong class={selected}>Credits</strong>
      </li>
    ) : (
      <li>
        <a class={normal} href="/credits">
          Credits
        </a>
      </li>
    )
  }
  [[ if .Staff ]]
  <li><a class={green} href="[[ .HousekeepingURL ]]"><b>Housekeeping</b></a></li>
  [[ end ]]
</ul>
