---
interface Props {
  variant?: "default" | "login";
  class?: string;
}

const { variant = "default", class: className } = Astro.props;

const palettes = {
  default: {
    root: "border-mauve-300 bg-taupe-200 shadow-[0_3px_0_var(--color-mauve-300)]",
    header: "bg-mauve-300 text-mauve-900",
  },
  login: {
    root: "border-mauve-300 bg-olive-400 text-white shadow-[0_3px_0_var(--color-mauve-300)]",
    header: "bg-neutral-500 text-white",
  },
};

const palette = palettes[variant];
---

<div
  class:list={[
    "flex w-full flex-col rounded-md border p-1",
    palette.root,
    className,
  ]}
>
  <header class:list={["rounded-sm p-1 text-center font-bold", palette.header]}>
    <slot name="title" />
  </header>

  <div class="p-2">
    <slot />
  </div>
</div>
