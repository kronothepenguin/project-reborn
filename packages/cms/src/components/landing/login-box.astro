---
import { Bubble, Button, Card, Checkbox, Notice } from "@project-reborn/components";

interface Props {
  links?: boolean;
}

const { links = true } = Astro.props;
---

[[ if .Error ]]
<Notice><p class="font-bold">[[ .Error ]]</p></Notice>
[[ end ]]
<Card variant="login" color="loginbox">
  <span slot="header">Sign in</span>

  <!-- Holo's login rows: 5px around each, the labels 75px wide, the fields
       99px, and the rows under them from 81px. -->
  <form method="post" action="/" class="text-white">
    <div class="flex items-center p-1">
      <label for="username" class="w-[75px] shrink-0">Username</label>
      <input
        id="username"
        name="username"
        type="text"
        value="[[ .Username ]]"
        class="mr-1.5 w-[99px] border border-neutral-600 bg-white p-1 text-black"
      />
    </div>
    <div class="flex items-center p-1">
      <label for="password" class="w-[75px] shrink-0">Password</label>
      <input
        id="password"
        name="password"
        type="password"
        class="mr-1.5 w-[99px] border border-neutral-600 bg-white p-1 text-black"
      />
      <Button type="submit">Sign in</Button>
    </div>

    <div class="group relative py-1.5 pr-1 pl-20">
      <Checkbox name="remember">
        Remember me
      </Checkbox>
      <div
        class="absolute top-full left-0 z-10 mt-2 hidden text-black group-has-checked:block"
      >
        <Bubble tail="top">
          By selecting 'remember me' you will stay signed in on this computer
          until you click 'Sign Out'. If this is a public computer please do not
          use this feature.
        </Bubble>
      </div>
    </div>

    {
      links && (
        <>
          <p class="py-1.5 pr-1 pl-20">
            <a href="/register" class="font-bold text-olive-800 underline hover:text-white">
              Register
            </a>
          </p>
          <p class="py-1.5 pr-1 pl-20">
            <a href="/forgot" class="text-olive-800 underline hover:text-white">
              I forgot my username/password
            </a>
          </p>
        </>
      )
    }
  </form>
</Card>
