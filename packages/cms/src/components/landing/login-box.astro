---
import { Bubble, Button, Card, Checkbox, Notice } from "@project-reborn/components";

interface Props {
  links?: boolean;
}

const { links = true } = Astro.props;
---

[[ if .Error ]]
<Notice><p class="font-bold">[[ .Error ]]</p></Notice>
[[ end ]]
<Card variant="login" color="loginbox">
  <span slot="header">Sign in</span>

  <form
    method="post"
    action="/"
    class="grid grid-cols-[1fr_1fr_1fr] items-center gap-2 text-sm"
  >
    <label for="username" class="text-white">
      Username
    </label>
    <input
      id="username"
      name="username"
      type="text"
      value="[[ .Username ]]"
      class="bg-white border min-w-24 w-full border-neutral-600 px-2 py-1"
    />

    <label for="password" class="text-white col-start-1">
      Password
    </label>
    <input
      id="password"
      name="password"
      type="password"
      class="border bg-white border-neutral-600 min-w-24 w-full px-2 py-1"
    />
    <Button type="submit">Sign in</Button>

    <div class="group relative col-start-2 col-span-2">
      <Checkbox name="remember" class="text-xs text-white">
        Remember me
      </Checkbox>
      <div
        class="absolute top-full left-0 z-10 mt-2 hidden text-black group-has-checked:block"
      >
        <Bubble tail="top">
          By selecting 'remember me' you will stay signed in on this computer
          until you click 'Sign Out'. If this is a public computer please do not
          use this feature.
        </Bubble>
      </div>
    </div>

    {
      links && (
        <>
          <a
            href="/register"
            class="col-start-2 col-span-2 underline text-xs font-bold text-olive-800 hover:text-white"
          >
            Register
          </a>

          <a
            href="/forgot"
            class="col-start-2 col-span-2 text-xs underline text-olive-800 hover:text-white"
          >
            I forgot my username/password
          </a>
        </>
      )
    }
  </form>
</Card>
