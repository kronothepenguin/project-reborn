---
import { Card, Link } from "@project-reborn/components";

const heading = "border-b border-dashed border-taupe-500 py-1 font-bold";
const list = "mb-[1.5em] ml-5";
---

<div class="mr-2.5 mb-2.5">
  <Card color="orange">
    <span slot="header">News</span>
    <div id="article-archive">
      <h2 class={heading}>News Headlines</h2>
      <ul class={list}>
        [[ range .Headlines ]]
        <li class="my-1.5"><Link href="/news/[[ .ID ]]">[[ .Title ]]</Link> &raquo;</li>
        [[ else ]]
        <li><br />No headlines to display yet.</li>
        [[ end ]]
      </ul>
      <h2 class={heading}>More news?</h2>
      <ul class={list}>
        <li class="my-1.5"><Link href="/news">View our news archive</Link> &raquo;</li>
      </ul>
    </div>
  </Card>
</div>
