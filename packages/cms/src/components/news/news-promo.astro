---
import { Paper } from "@project-reborn/components";
import TopStories from "./top-stories.svelte";
---

<div>
  <Paper>
    <div id="newspromo">
      [[ if .TopStories ]]
      <!-- The stories share one cell of a grid, so the box is as tall as the
           longest, and at least as tall as Holo's 187px picture, which stands
           at its own size at the left, as Holo's, on Holo's olive. -->
      <div id="topstories" class="grid">
        [[ range $i, $story := .TopStories ]]
        <div
          data-story="[[ if $i ]]hidden[[ else ]]shown[[ end ]]"
          class="topstory col-start-1 row-start-1 min-h-[187px] bg-olive-300 bg-no-repeat px-4.5 pt-1.5 pb-3.5 text-white transition-[opacity,visibility] duration-800 data-[story=hidden]:invisible data-[story=hidden]:opacity-0"
          style="background-image: url('[[ $story.Image ]]')"
        >
          <h4 class="mb-1 uppercase">Latest news</h4>
          <h3 class="mb-3.5 text-2xl font-bold">
            <a class="text-white no-underline hover:underline" href="/news/[[ $story.ID ]]">[[ $story.Title ]]</a>
          </h3>
          <p class="w-[65%]">[[ $story.Summary ]]</p>
          <p><a class="text-white underline" href="/news/[[ $story.ID ]]">Read more &raquo;</a></p>
        </div>
        [[ end ]]
      </div>
      <TopStories client:only="svelte" source="topstories" />
      [[ end ]]
      <ul>
        [[ range $i, $item := .MoreNews ]]
        <li class="px-4.5 py-[0.5em] [[ if not $i ]] bg-olive-200 [[ end ]]">
          <a class="text-olive-800 no-underline hover:underline" href="/news/[[ $item.ID ]]">[[ $item.Title ]]</a>
          <div class="mt-0.5 text-sm text-olive-500">[[ $item.Date ]]</div>
        </li>
        [[ end ]]
        <li class="px-4.5 py-[0.5em] text-right"><a class="text-orange-500 underline" href="/news">More news &raquo;</a></li>
      </ul>
    </div>
  </Paper>
</div>
