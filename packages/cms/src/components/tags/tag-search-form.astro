---
import { Button, Icon } from "@project-reborn/components";
---

<div class="mt-[1em]">
  <form action="/tags" class="flex items-center gap-1.5">
    <input type="text" name="tag" aria-label="Tag" class="min-w-0 flex-1 border border-neutral-600 bg-white p-1.5 text-black" />
    <Button type="submit" size="compact" aria-label="Search"><Icon variant="search" /></Button>
  </form>
</div>
