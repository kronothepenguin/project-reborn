---
import { Button, Icon } from "@project-reborn/components";
---

<div class="mt-[1em]">
  <form action="/tags" class="flex items-center gap-2.5">
    <input type="text" name="tag" aria-label="Tag" class="w-[171px] border border-neutral-600 bg-white p-1 text-black" />
    <Button type="submit" size="compact" aria-label="Search"><Icon variant="search" /></Button>
  </form>
</div>
