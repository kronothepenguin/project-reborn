---
import { Input } from "@project-reborn/components";
import BirthDate from "../habbo/birth-date.astro";
import SettingsStep from "./settings-step.astro";

interface Props {
  spaced?: boolean;
}

const { spaced = false } = Astro.props;
---

<SettingsStep number={1} heading="Give your current details" spaced={spaced}>
  <p class="pb-3 [&_input]:w-[243px]">
    <label for="currentpassword">Current password:</label><br />
    <Input id="currentpassword" type="password" name="password" maxlength="32" variant="border" />
  </p>
  <div>
    <div><label for="details-day">Birthdate:</label></div>
    <BirthDate id="required-birthday" prefix="details" class="flex gap-1" />
  </div>
</SettingsStep>
