---
// Holo's settings-step: the number floats at the left of the step's content,
// 1.2em under the step before it. Holo's email form sets its headings' margins
// to none; the password form keeps 4px above and below them (spaced).
interface Props {
  number: number;
  heading: string;
  spaced?: boolean;
}

const { number, heading, spaced = false } = Astro.props;
---

<div class="clear-both pt-3.5">
  <h4 class="float-left font-bold">{number}.</h4>
  <div class="pl-7.5">
    <h3 class:list={["text-xs font-bold", spaced && "my-1"]}>{heading}</h3>
    <slot />
  </div>
</div>
