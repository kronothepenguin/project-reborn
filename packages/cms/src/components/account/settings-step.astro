---
interface Props {
  number: number;
  heading: string;
}

const { number, heading } = Astro.props;
---

<div class="flex gap-5.5 pt-4">
  <h4 class="w-4.5 shrink-0 font-bold">{number}.</h4>
  <div class="flex flex-col gap-2.5">
    <h3 class="text-lg font-bold">{heading}</h3>
    <slot />
  </div>
</div>
