---
interface Props {
  number: number;
  heading: string;
}

const { number, heading } = Astro.props;
---

<div class="flex gap-4 pt-3">
  <h4 class="w-3.5 shrink-0 font-bold">{number}.</h4>
  <div class="flex flex-col gap-2">
    <h3 class="text-xs font-bold">{heading}</h3>
    <slot />
  </div>
</div>
