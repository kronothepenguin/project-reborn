---
import { Avatar } from "@project-reborn/components";
import bigIcons from "../../assets/me/big_icons.png";
import closeMessage from "../../assets/me/close_msg.png";
import enterButton from "../../assets/me/enter_button.png";
import flashyArrow from "../../assets/me/flashy_arrow.gif";
import hotelView from "../../assets/me/hotel-view.png";
import infoIcons from "../../assets/me/info_icons.png";
import orangeThing from "../../assets/me/orange_thing.png";
import plate from "../../assets/me/info_habbo_plate.png";
import smallIcons from "../../assets/me/small_icons.png";
import Feed from "./feed.svelte";
import MottoEditor from "./motto-editor.svelte";

const sprite = (image: { src: string }, position: string) =>
  `background: url(${image.src}) no-repeat ${position}`;
const linkItem = "py-0.5 pl-6.5 leading-5";
const feedItem = "min-h-7 border-t border-dotted border-olive-500 py-2.5 pr-1.5 pl-15 first:border-t-0";
---

<!-- Holo's personal info: the hotel view at its own size, 450x143, the habbo's
     plate over its corner, the motto and the links. Where the column is wider
     than the view, the links stand beside it, so the box wraps the picture; on
     a narrower column they run under the motto as Holo's, and on a phone the
     view shows as much of itself as fits. -->
<div id="new-personal-info" class="@container relative flex flex-wrap rounded-t bg-olive-500">
  <div
    id="hotel-view"
    class="relative h-[143px] w-full max-w-[450px] shrink-0 overflow-hidden rounded-tl"
    style={`background: url(${hotelView.src}) no-repeat`}
  >
    <div
      class="absolute top-[15px] right-10 py-7"
      style={`background: url(${orangeThing.src}) no-repeat 50% 0`}
    >
      [[ if .Online ]]
      <div class="group/enter flex">
        <a
          href="/client"
          target="client"
          class="relative h-[49px] bg-no-repeat pr-[26px] pl-[19px] text-center text-xl leading-[47px] text-white no-underline [background-position:-9px_0] group-hover/enter:[background-position:-9px_-49px]"
          style={`background-image: url(${enterButton.src})`}
        >
          Enter [[ .ShortName ]]<i
            class="absolute top-[13px] right-0 h-px bg-no-repeat p-2.5 text-[1px] leading-px [background-position:0_50%]"
            style={`background-image: url(${flashyArrow.src})`}></i>
        </a>
        <b
          class="h-[49px] w-[9px] bg-no-repeat [background-position:0_0] group-hover/enter:[background-position:0_-49px]"
          style={`background-image: url(${enterButton.src})`}></b>
      </div>
      [[ else ]]
      <div class="flex">
        <span
          class="h-[49px] pr-2.5 pl-[19px] text-center text-xl leading-[47px] text-white"
          style={sprite(enterButton, "-9px -98px")}
        >
          Hotel Closed
        </span>
        <b
          class="h-[49px] w-[9px]"
          style={sprite(enterButton, "0 -98px")}></b>
      </div>
      [[ end ]]
    </div>
  </div>

  <div
    class="group absolute top-12 left-[15px] h-[138px] w-[96px] text-center"
    style={sprite(plate, "2px -162px")}
  >
    <a href="/account/looks">
      <Avatar
        imagingUrl="[[ .ImagingURL ]]"
        figure="[[ .Figure ]]"
        direction={3}
        headDirection={3}
        gesture="sml"
        alt="[[ .Habbo ]]"
        width="64"
        height="110"
        class="mx-auto"
      />
    </a>
  </div>

  <div class="order-3 w-full pt-3.5 pr-4 pb-1.5">
    <div class="relative ml-30 flex h-6 max-w-117.5 items-center rounded bg-white px-1">
      <strong class="shrink-0 px-3.5">[[ .Habbo ]]:</strong>
      <div class="min-w-0 flex-1">
        <span
          id="motto-text"
          data-motto="[[ .Motto ]]"
          class="block truncate text-mist-600"
        >
          [[ if .Motto ]][[ .Motto ]][[ else ]]Click here to enter your motto[[ end ]]
        </span>
        <MottoEditor client:only="svelte" source="motto-text" />
      </div>
    </div>
  </div>

  <ul
    id="link-bar"
    class="order-4 flex w-full flex-wrap gap-x-10 gap-y-1 px-5.5 pt-1 pb-1.5 text-white @min-[40rem]:order-2 @min-[40rem]:w-auto @min-[40rem]:flex-1 @min-[40rem]:flex-col @min-[40rem]:justify-center @min-[40rem]:gap-y-3"
  >
    <li class={linkItem} style={sprite(infoIcons, "0 -976px")}>
      <a href="/account/looks">Change looks &raquo;</a>
    </li>
    <li class={linkItem} style={sprite(infoIcons, "0 -143px")}>
      <a href="/credits">[[ .Credits ]]</a> credits
    </li>
    <li class={linkItem} style={sprite(infoIcons, "0 -95px")}>
      [[ if .ClubDays ]]
      <a href="/club">[[ .ClubDays ]]</a> HC days
      [[ else ]]
      <a href="/club">Join [[ .ShortName ]] club &raquo;</a>
      [[ end ]]
    </li>
  </ul>

  <div class="order-5 w-full rounded-b bg-stone-400">
    <ul id="feed-items">
      [[ if .OpenHelp ]]
      <li class={`${feedItem} text-sm`} style={sprite(smallIcons, "15px -456px")}>
        <strong>Staff Message</strong><br />
        [[ if .OneOpenHelp ]]There is[[ else ]]There are[[ end ]] <strong><a class="text-white" href="[[ .HousekeepingURL ]]/help">[[ .OpenHelp ]]</a></strong> non-picked up help [[ if .OneOpenHelp ]]query[[ else ]]queries[[ end ]].
      </li>
      [[ end ]]
      [[ range .Alerts ]]
      <li class={feedItem}>
        <form method="post" action="/me/alerts/[[ .ID ]]/dismiss" class="float-right">
          <button
            type="submit"
            title="Remove notification"
            aria-label="Remove notification"
            class="block h-[13px] w-[13px] cursor-pointer"
            style={sprite(closeMessage, "0 0")}></button>
        </form>
        <div class="mr-5">
          <b>[[ if .Staff ]]Message from [[ $.ShortName ]] Staff[[ else ]]Notification[[ end ]]</b><br />
          <span class="whitespace-pre-line">[[ .Message ]]</span>
        </div>
      </li>
      [[ end ]]
      [[ if .Birthday ]]
      <li class={`${feedItem} font-bold text-white`} style={sprite(bigIcons, "-3153px 6px")}>
        <div>
          Happy [[ .Birthday ]] birthday, [[ .Habbo ]]!<br />We hope you have a
          great day today.
        </div>
      </li>
      [[ end ]]
      [[ if .LastSignIn ]]
      <li class={`${feedItem} text-sm`} style={sprite(smallIcons, "15px -297px")}>
        Last signed in: [[ .LastSignIn ]]
      </li>
      [[ end ]]
    </ul>
    <Feed client:only="svelte" list="feed-items" />
  </div>
</div>
