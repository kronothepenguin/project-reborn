---
// transactions.php's tx-log: its words, and the table of the ledger with the
// Habbo column of 0104.
import { Table } from "@project-reborn/components";

const cell = "px-[15px] py-0.5";
const heading = `${cell} text-xs font-normal text-neutral-400`;
---

<div class="px-[15px] py-2">
  This is an overview of your credit transaction history. They are updated as soon as the transaction is made. You can
  see up to 50 records.
</div>
<Table variant="plain">
  <thead>
    <tr>
      <th class:list={[heading, "text-left whitespace-nowrap"]}>Date</th>
      <th class:list={[heading, "text-center"]}>Activity</th>
      <th class:list={[heading, "w-full text-left"]}>Description</th>
      <th class:list={[heading, "text-left"]}>Habbo</th>
    </tr>
  </thead>
  <tbody>
    [[ range .Transactions ]]
    <tr class="[[ if .Odd ]]bg-taupe-100[[ end ]]">
      <td class:list={[cell, "text-left whitespace-nowrap"]}>[[ .Date ]]</td>
      <td class:list={[cell, "text-center"]}>[[ .Activity ]]</td>
      <td class:list={[cell, "w-full text-left"]}>[[ .Description ]]</td>
      <td class:list={[cell, "text-left"]}>[[ .Habbo ]]</td>
    </tr>
    [[ end ]]
  </tbody>
</Table>
