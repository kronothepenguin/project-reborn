---
import { Avatar, Card, GroupBadge } from "@project-reborn/components";
import offline from "../assets/staff/habbo_offline.gif";
import Community from "../layouts/community.astro";

const body = "[&_a]:text-orange-500 [&_a]:underline";
---

<Community title="[[ .ShortName ]] ~ Staff Team" tab="community" sub="Staff">
  <div class="flex">
    <div class="w-[460px]">
      <div class="mr-2 mb-[7px]">
        <Card color="green">
          <span slot="header">Staff</span>
          <div id="staff-list">
            [[ range .Members ]]
            <p class="my-[1em] flow-root">
              <Avatar
                class="float-left"
                imagingUrl="[[ $.ImagingURL ]]"
                figure="[[ .Figure ]]"
                size="b"
                direction={2}
                headDirection={3}
                gesture="sml"
                alt="[[ .Name ]]"
              />
              <b><a class="text-orange-500 underline" href="/home?name=[[ .Name ]]">[[ .Name ]]</a></b>&nbsp;<img class="inline" src={offline.src} width={offline.width} height={offline.height} title="Offline" alt="Offline" /><br />
              <i>[[ .Motto ]]</i><br />
              <br />
              Rank: [[ .Rank ]]<br />
              Last Visit: [[ .LastVisit ]]<br />
              <br />[[ if .Badge ]]<img class="inline" src="[[ .Badge ]]" alt="" />[[ end ]]&nbsp;[[ if .Group ]]<a
                href="/groups/[[ .Group ]]"><GroupBadge class="inline" code="[[ .GroupBadge ]]" /></a
              >[[ end ]]<br /><br />
            </p>
            [[ else ]]
            No staff to display yet.
            [[ end ]]
          </div>
        </Card>
      </div>
    </div>
    <div class="w-[310px]">
      [[ range .Boxes ]]
      <div class="mr-2 mb-[7px]">
        [[ if eq .Color "red" ]]
        <Card color="red"><span slot="header">[[ .Heading ]]</span><div class={body}>[[ .Body ]]</div></Card>
        [[ else if eq .Color "blue" ]]
        <Card color="blue"><span slot="header">[[ .Heading ]]</span><div class={body}>[[ .Body ]]</div></Card>
        [[ else if eq .Color "white" ]]
        <Card color="white"><span slot="header">[[ .Heading ]]</span><div class={body}>[[ .Body ]]</div></Card>
        [[ else ]]
        <Card color="green"><span slot="header">[[ .Heading ]]</span><div class={body}>[[ .Body ]]</div></Card>
        [[ end ]]
      </div>
      [[ end ]]
    </div>
    <div class="w-[160px]"></div>
  </div>
</Community>
