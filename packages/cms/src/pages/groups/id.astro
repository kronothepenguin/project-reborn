---
import GroupActions from "../../components/groups/group-actions.svelte";
import GroupTitle from "../../components/groups/group-title.astro";
import GroupTools from "../../components/groups/group-tools.svelte";
import HomeView from "../../components/homes/home-view.astro";
import Community from "../../layouts/community.astro";
---

<Community title="[[ .ShortName ]] ~ [[ .Group ]]" tab="community" sub="">
  <HomeView>
    <Fragment slot="header">
      <div
        id="group-settings-data"
        hidden
        data-name="[[ .Group ]]"
        data-description="[[ .Info.Description ]]"
        data-access="[[ .Access ]]"
        data-badge="[[ .Info.Badge ]]"
        data-name-max="[[ .NameMax ]]"
        data-description-max="[[ .DescriptionMax ]]"
        data-max-members="[[ .MaxMembers ]]"
      >
      </div>
      <GroupTools
        client:only="svelte"
        group="[[ .GroupID ]]"
        admin="[[ .Viewer.Admin ]]"
        owner="[[ .Viewer.Owner ]]"
        me="[[ .Viewer.Me ]]"
        source="group-settings-data"
      />
      <GroupTitle />
      [[ if .SignedIn ]]
      <GroupActions
        client:only="svelte"
        group="[[ .GroupID ]]"
        join="[[ .Viewer.Join ]]"
        favourite="[[ .Viewer.Favourite ]]"
        leave="[[ .Viewer.Leave ]]"
      />
      [[ end ]]
    </Fragment>
  </HomeView>
</Community>
