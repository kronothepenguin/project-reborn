---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Habbo Hotel</title>
  </head>
  <body class="bg-sky-200">
    <div class="mx-auto mt-3 max-w-[766px] rounded-xl border border-sky-300 bg-white px-5 py-4 shadow-sm">
      <header class="relative">
        <h1 class="text-3xl font-bold tracking-tight text-black">Habbo</h1>
        <ul class="flex items-center gap-8 text-sm text-orange-600">
          <li><span class="font-bold text-black">12,345</span> users online now</li>
          <li class="flex items-center gap-1.5 font-bold text-zinc-700">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-green-500"></span>
            Hotel ON
          </li>
        </ul>
      </header>

      <main class="mt-4 flex gap-2">
        <div class="flex-1">
          <div class="flex h-[389px] flex-col items-center justify-end gap-4 rounded-md border border-cyan-800 bg-gradient-to-b from-cyan-600 to-cyan-800">
            <a
              href="#"
              class="rounded bg-green-500 px-8 py-2 font-bold text-white shadow hover:bg-green-600"
            >
              Join now, it's free &raquo;
            </a>
            <p class="mb-4 px-6 text-center text-sm font-bold text-white">
              Habbo is a virtual world where you can meet and make friends.
            </p>
          </div>

          <div class="mt-1 rounded-md border border-green-200 bg-green-100">
            <h2 class="rounded-t-md bg-green-600 px-3 py-1.5 text-sm font-bold text-white">
              To get most out of Habbo, do this:
            </h2>
            <ul class="list-disc px-6 py-2 text-xs text-zinc-700">
              <li>
                <a class="text-sky-700 underline" href="#">Install Flash Player 8 or higher</a>
              </li>
            </ul>
          </div>
        </div>

        <div class="flex w-full max-w-[310px] flex-col gap-1">
          <div class="rounded-md bg-zinc-400">
            <h2 class="rounded-t-md bg-zinc-600 px-3 py-1.5 text-sm font-bold text-white">Sign in</h2>
            <form method="post" class="flex flex-col gap-2 p-3 text-white">
              <label class="flex flex-col gap-0.5">
                <span class="text-xs">Username</span>
                <input
                  type="text"
                  name="username"
                  class="rounded border border-zinc-500 bg-zinc-100 px-2 py-1 text-sm text-zinc-900"
                />
              </label>
              <div class="flex items-end gap-1">
                <label class="flex flex-1 flex-col gap-0.5">
                  <span class="text-xs">Password</span>
                  <input
                    type="password"
                    name="password"
                    class="rounded border border-zinc-500 bg-zinc-100 px-2 py-1 text-sm text-zinc-900"
                  />
                </label>
                <button
                  type="submit"
                  class="rounded bg-sky-600 px-4 py-1.5 text-sm font-bold text-white hover:bg-sky-700"
                >
                  Sign in
                </button>
              </div>
              <label class="text-xs">
                <input type="checkbox" name="_login_remember_me" value="true" class="mr-1" />
                Remember me
              </label>
              <a href="#" class="text-xs font-bold text-zinc-800 underline">Register for free</a>
              <a href="#" class="text-xs text-zinc-800 underline">I forgot my password/username</a>
            </form>
          </div>

          <div class="h-40 rounded-md border border-zinc-300 bg-zinc-200"></div>

          <div class="h-40 rounded-md border border-zinc-300 bg-zinc-200"></div>
        </div>
      </main>

      <footer class="mt-4 border-t border-zinc-100 pt-3 text-center text-xs text-zinc-500">
        <p>
          <a href="#" class="text-sky-700 underline">Homepage</a>
          <span class="text-zinc-300">|</span>
          <a href="#" class="text-sky-700 underline">Terms of Service</a>
          <span class="text-zinc-300">|</span>
          <a href="#" class="text-sky-700 underline">Privacy Policy</a>
        </p>
        <p class="mt-1">
          Powered by <a href="#" class="text-sky-700 underline">Project Reborn</a> &copy; 2026
        </p>
      </footer>
    </div>
  </body>
</html>
