---
import { Card } from "@project-reborn/components";
import partyAdvert from "../assets/landing/party.gif";
import JoinButton from "../components/landing/join-button.astro";
import LoginBox from "../components/landing/login-box.astro";
import PromoWidget from "../components/landing/promo-widget.svelte";
import SignedOut from "../layouts/signed-out.astro";
---

<SignedOut title="[[ .ShortName ]] ~ Home">
  <main class="flex gap-2 py-4">
    <div class="flex-3 w-96">
      [[ if .LandingPromo ]]
      <div
        id="habbos-v2-container"
        data-slogan="[[ .Name ]] is a virtual world where you can meet and make friends!"
      >
      </div>
      <PromoWidget client:only="svelte" container="habbos-v2-container" />
      <noscript>
        <div class="flex flex-col gap-2">
          <JoinButton />
          <Card color="green">
            <span slot="header">To get most out of [[ .ShortName ]], do this:</span>
            <ul class="text-sm">
              <li>Enable JavaScript</li>
            </ul>
          </Card>
        </div>
      </noscript>
      [[ else ]]
      <JoinButton />
      [[ end ]]
    </div>

    <div class="flex-2 flex flex-col gap-2 w-72">
      <LoginBox />
      <a href="/register">
        <img
          src={partyAdvert.src}
          width={partyAdvert.width}
          height={partyAdvert.height}
          alt=""
        />
      </a>
    </div>
  </main>
</SignedOut>
