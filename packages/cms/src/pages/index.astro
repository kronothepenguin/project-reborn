---
import { Button, Card } from "@project-reborn/components";
import SignedOut from "../layouts/signed-out.astro";
---

<SignedOut title="Habbo Hotel">
  <main class="flex gap-2 py-4">
    <div class="flex-3">
      <Card>
        <div class="flex flex-col items-center gap-2">
          <a href="/register" class="relative w-72 h-10 flex">
            <span class="absolute text-white font-bold left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2">
              Join now, it's free &raquo;
            </span>

            <svg xmlns="http://w3.org" viewBox="0 0 5 40">
              <path
                class="text-black/20"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                d="M 4 38.5 H 268"
              />

              <path
                class="text-lime-900"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M 5 1 C 1 1, 1 1, 1 5 V 31 M 1 31 C 1 36, 1 36, 5 36"
              />

              <path
                class="text-lime-600"
                fill="currentColor"
                d="M 2 2 H 6 V 35 H 2"
              />
            </svg>

            <svg xmlns="http://w3.org" viewBox="0 0 268 40">
              <path
                class="text-black/20"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                d="M 0 38.5 H 268"
              />

              <path
                class="text-lime-900"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M 0 1 L 268 1 M 0 36 L 268 36"
              />

              <path
                class="text-lime-600"
                fill="currentColor"
                d="M 0 2 H 268 V 35 H 0"
              />

              <path
                class="text-lime-500"
                stroke="currentColor"
                stroke-width="4"
                d="M 0 33 H 268"
              />
            </svg>

            <svg xmlns="http://w3.org" viewBox="0 0 17 40">
              <path
                class="text-black/20"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                d="M 0 38.5 L 17 22"
              />

              <path
                class="text-lime-900"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M 0 1 L 16 16 L 16 21 L 0 36"
              />

              <path
                class="text-lime-600"
                fill="currentColor"
                d="M 0 2 L 15 16 L 15 21 L 0 35"
              />

              <path
                class="text-lime-500"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                d="M -1 34 L 13 21"
              />
            </svg>
          </a>
          <p class="p-2 text-sm">
            Holo is a virtual world where you can meet and make friends.
          </p>
        </div>
      </Card>
    </div>

    <div class="flex-2 flex flex-col gap-2 min-w-72">
      [[ if .Error ]]
      <div class="bg-red-600 p-1 text-sm text-center rounded">
        <p class="font-bold text-white">[[ .Error ]]</p>
      </div>
      [[ end ]]
      <Card variant="login" color="loginbox">
        <span slot="header">Sign In</span>

        <form
          method="post"
          class="grid grid-cols-[1fr_1fr_1fr] items-center gap-2 text-sm"
        >
          <label for="username" class="text-white">
            Username
          </label>
          <input
            id="username"
            name="username"
            type="text"
            class="bg-white border min-w-24 w-full border-neutral-600 px-2 py-1"
          />

          <label for="password" class="text-white col-start-1">
            Password
          </label>
          <input
            id="password"
            name="password"
            type="password"
            class="border bg-white border-neutral-600 min-w-24 w-full px-2 py-1"
          />
          <Button type="submit">Sign In</Button>

          <label class="col-start-2 col-span-2 flex items-center gap-1 text-xs text-white">
            <input type="checkbox" name="remember" />
            Remember me
          </label>

          <a
            href="/register"
            class="col-start-2 col-span-2 underline text-xs font-bold text-olive-800 hover:text-white"
          >
            Register for free
          </a>

          <a
            href="/forgot"
            class="col-start-2 col-span-2 text-xs underline text-olive-800 hover:text-white"
          >
            I forgot my password/username
          </a>
        </form>
      </Card>
    </div>
  </main>
</SignedOut>
