---
import { Button, Card } from "@project-reborn/components";
import SignedOut from "../layouts/signed-out.astro";
---

<SignedOut title="Habbo Hotel">
  <main class="flex gap-2 py-4">
    <div class="flex-3">
      <Card>
        <div class="flex flex-col items-center gap-2">
          <a
            href="/register"
            class="rounded border-2 border-b-[3px] border-lime-900 border-b-lime-500 bg-lime-600 px-4 py-1.5 font-bold text-white shadow-[0_3px_0_var(--color-lime-900)]"
          >
            Join now, it's free &raquo;
          </a>
          <p class="p-2 text-sm">
            Holo is a virtual world where you can meet and make friends.
          </p>
        </div>
      </Card>
    </div>

    <div class="flex-2 flex flex-col gap-2 min-w-72">
      [[ if or .Errors.General .Errors.Username .Errors.Password ]]
      <div class="bg-red-600 p-1 text-sm text-center rounded">
        <p class="font-bold text-white">
          [[ or .Errors.General .Errors.Username .Errors.Password ]]
        </p>
      </div>
      [[ end ]]
      <Card variant="login" color="loginbox">
        <span slot="header">Sign In</span>

        <form
          method="post"
          class="grid grid-cols-[1fr_1fr_1fr] items-center gap-2 text-sm"
        >
          <label for="username" class="text-white">
            Username
          </label>
          <input
            id="username"
            name="username"
            type="text"
            value="[[ .Values.Username ]]"
            class="bg-white border min-w-24 w-full border-neutral-600 px-2 py-1"
          />

          <label for="password" class="text-white col-start-1">
            Password
          </label>
          <input
            id="password"
            name="password"
            type="password"
            class="border bg-white border-neutral-600 min-w-24 w-full px-2 py-1"
          />
          <Button type="submit">Sign In</Button>

          <label class="col-start-2 col-span-2 flex items-center gap-1 text-xs text-white">
            <input type="checkbox" name="remember" />
            Remember me
          </label>

          <a
            href="/register"
            class="col-start-2 col-span-2 underline text-xs font-bold text-olive-800 hover:text-white"
          >
            Register for free
          </a>

          <a
            href="/forgot"
            class="col-start-2 col-span-2 text-xs underline text-olive-800 hover:text-white"
          >
            I forgot my password/username
          </a>
        </form>
      </Card>
    </div>
  </main>
</SignedOut>
