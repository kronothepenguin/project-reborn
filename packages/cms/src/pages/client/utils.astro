---
import { Card } from "@project-reborn/components";
import Document from "../../layouts/document.astro";

// clientutils.php's three pages, in templates/client/subheader.php's popup:
// the connection failed, a fatal error, and the sign-in a guest needs first;
// and Hotel Closed, for a client that lost its connection while the game is
// stopped, with the Me page's heading and client.php's "<site name> is offline".
---

<Document
  title="[[ .ShortName ]] ~ "
  description="[[ .Name ]] is a virtual world where you can meet and make friends."
  keywords="[[ .ShortName ]],virtual world,play games,enter competitions,make friends"
>
  <!-- Habbo's habboclient.css, which Holo's page loads: a black page and the
       box centred 88px under the top of the content. -->
  <main class="min-h-screen bg-black pt-[90px]">
    <div class="mx-auto w-[456px] pr-2 text-xs [&_p]:pb-3">
      [[ if eq .Key "connection_failed" ]]
      <Card color="orange">
        <h2 slot="header">Connection to [[ .Name ]] failed.</h2>
        <p>
          Unfortunately we are unable to connect you to [[ .Name ]]. This could be because your computer is blocking the
          connections via a firewall. Please verify with the person responsible for your Internet connection that the
          following addresses are permitted by the firewall: IP address: [[ .Host ]], TCP port: [[ .Port ]]
        </p>
      </Card>
      [[ else if eq .Key "closed" ]]
      <Card color="orange">
        <h2 slot="header">Hotel Closed</h2>
        <p>[[ .Name ]] is offline</p>
      </Card>
      [[ else if eq .Key "error" ]]
      <Card color="orange">
        <h2 slot="header">Fatal Error</h2>
        <p>
          An unknown error occurred. Please try again later in a couple of minutes. If this error is persistent, use the
          Help Tool to request support.
        </p>
      </Card>
      [[ else ]]
      <Card color="orange">
        <h2 slot="header">Sign in</h2>
        <p class="text-center">
          In order to use the game client and the complete website, please <a href="/" target="_self" class="text-orange-500 underline"><strong>sign in</strong></a>! If you forgot your username or password, please click <a href="/forgot" class="text-orange-500 underline">here</a>.
        </p>
      </Card>
      [[ end ]]
    </div>
  </main>
</Document>
