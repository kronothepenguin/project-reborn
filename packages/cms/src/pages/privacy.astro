---
import Terms from "../components/legal/terms.astro";
import SignedOut from "../layouts/signed-out.astro";
---

<SignedOut title="[[ .ShortName ]]: Privacy Policy">
  <Terms title="Privacy Policy">
    Here at <b>[[ .Name ]]</b> (also referred to as <b>[[ .ShortName ]]</b>) we
    care about your privacy. All your credentials and other information given
    during the registration process will be stored in a secure database which
    only several individuals have access to. [[ .Name ]] will <i>never</i> share
    your information with any third party without your explicit prior permission
    to do so.
  </Terms>
</SignedOut>
