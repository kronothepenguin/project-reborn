---
import { Card } from "@project-reborn/components";
import PurseBox from "../components/credits/purse-box.astro";
import Community from "../layouts/community.astro";

const body = "flow-root [&_a]:text-orange-500 [&_a]:underline";
---

<Community title="[[ .ShortName ]] ~ Credits" tab="credits" sub="Credits">
  <div class="flex">
    <div class="w-153.5">
      <div class="mr-2.5 mb-2.5">
        <Card color="green">
          <span slot="header">[[ .Box2Heading ]]</span>
          <div class={body}>
            <img class="float-left" src="/web-gallery/album1/palmchair.gif" width="96" height="146" alt="" />[[ .Box2Body ]]
          </div>
        </Card>
      </div>
    </div>
    <div class="w-103.5">
      <div class="mr-2.5 mb-2.5"><PurseBox /></div>
      <div class="mr-2.5 mb-2.5">
        <Card color="blue">
          <span slot="header">[[ .Box1Heading ]]</span>
          <div id="credits-promo" class={body}>
            <img
              class="float-left"
              src="/web-gallery/v2/images/credits/credits_permission.png"
              width="114"
              height="136"
              alt=""
            />[[ .Box1Body ]]
          </div>
        </Card>
      </div>
    </div>
  </div>
</Community>
