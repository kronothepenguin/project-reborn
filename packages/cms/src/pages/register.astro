---
import {
  Button,
  Checkbox,
  Icon,
  Input,
  Link,
  Notice,
} from "@project-reborn/components";
import termsIcon from "../assets/register/terms-icon.gif";
import AvatarEditor from "../components/habbo/avatar-editor.svelte";
import BirthDate from "../components/habbo/birth-date.astro";
import RegisterFormField from "../components/register/register-form-field.svelte";
import RegistrationForm from "../components/register/registration-form.svelte";
import SignedOut from "../layouts/signed-out.astro";
---

<SignedOut title="[[ .ShortName ]] ~ Register">
  [[ with .Errors.form ]]
  <div class="pt-2"><Notice>[[ . ]]</Notice></div>
  [[ end ]]

  <form
    id="registerform"
    method="post"
    action="/register"
    autocomplete="off"
    data-password-min="[[ .PasswordMinLength ]]"
    class="flex flex-col gap-2 pt-2 pb-4"
  >
    <input
      type="hidden"
      id="register-figure"
      name="figure"
      value="[[ .Figure ]]"
    />
    <input
      type="hidden"
      id="register-gender"
      name="gender"
      value="[[ .Gender ]]"
    />
    <input
      type="hidden"
      id="register-editor-state"
      name="editorState"
      value="[[ .EditorState ]]"
    />
    <input type="hidden" name="refer" value="[[ .Refer ]]" />

    <div id="register-columns" class="flex gap-4">
      <div class="grow space-y-2">
        <header class="rounded bg-yellow-900 text-white flex px-4 py-2">
          <span class="font-bold">1.</span>
          <h2 class="font-bold text-center w-full">Create Your Avatar</h2>
        </header>

        [[ with .Errors.look ]]
        <Notice>[[ . ]]</Notice>
        [[ end ]]
        <AvatarEditor
          client:only="svelte"
          figureInput="register-figure"
          genderInput="register-gender"
          stateInput="register-editor-state"
        />
      </div>

      <div class="flex flex-col gap-2 flex-1">
        <section id="register-section-2" class="bg-cyan-600 rounded-md px-4 py-2">
          <header class="text-white flex">
            <span class="font-bold">2.</span>
            <h2 class="font-bold text-center w-full">CHOOSE YOUR NAME</h2>
          </header>
          <div class="flex flex-col items-center gap-1">
            <label for="register-name" class="text-xs text-white font-bold">
              Habbo name
            </label>
            <div class="flex flex-wrap gap-2 items-center justify-center">
              <Input id="register-name" name="name" value="[[ .Habbo ]]" />
              <span id="register-name-check-container" hidden>
                <Button
                  id="register-name-check"
                  size="compact"
                  aria-label="Click here to check your name is free."
                >
                  <Icon />
                </Button>
              </span>
            </div>
            <div id="name-error-box" class="w-full">
              [[ with .Errors.name ]]
              <Notice>[[ . ]]</Notice>
              [[ end ]]
            </div>
          </div>
        </section>

        <section
          id="register-section-3"
          class="relative bg-neutral-400 rounded-md p-1 w-full"
        >
          <div
            id="registration-overlay"
            hidden
            class="absolute inset-0 z-10 rounded-md bg-olive-400/50"
          >
          </div>
          <header class="bg-olive-800 text-white flex font-bold rounded p-1">
            <span>3.</span>
            <h2 class="text-center w-full">Your Details</h2>
          </header>
          <div class="flex flex-col gap-2 px-3 py-2">
            [[ with .Errors.password ]]
            <Notice>[[ . ]]</Notice>
            [[ end ]]
            <RegisterFormField label="My password will be:">
              <Input id="register-password" type="password" name="password" />
            </RegisterFormField>

            <RegisterFormField label="Confirm password">
              <Input
                id="register-password2"
                type="password"
                name="passwordConfirm"
              />
            </RegisterFormField>

            [[ with .Errors.bornOn ]]
            <Notice>[[ . ]]</Notice>
            [[ end ]]
            <div class="flex flex-col">
              <span class="text-center text-xs text-white">I was born on:</span>
              <BirthDate id="register-birthday" prefix="register" class="flex justify-center gap-1" />
            </div>

            [[ with .Errors.email ]]
            <Notice>[[ . ]]</Notice>
            [[ end ]]
            <RegisterFormField label="And my email address is:">
              <Input
                id="register-email"
                name="email"
                value="[[ .Email ]]"
                maxlength="48"
              />
            </RegisterFormField>

            <RegisterFormField label="Retype your email address">
              <Input id="register-email2" name="emailConfirm" maxlength="48" />
            </RegisterFormField>

            [[ if .Newsletter ]]
            <Checkbox name="newsletter" checked class="text-sm text-white">
              Yes, please send me [[ .ShortName ]] updates, including the
              newsletter!
            </Checkbox>
            [[ else ]]
            <Checkbox name="newsletter" class="text-sm text-white">
              Yes, please send me [[ .ShortName ]] updates, including the
              newsletter!
            </Checkbox>
            [[ end ]]

            [[ with .Errors.terms ]]
            <Notice>[[ . ]]</Notice>
            [[ end ]]
            <div
              id="register-terms-content"
              class="flex flex-col gap-4 bg-mist-600 px-4 py-2 text-white rounded"
            >
              <a
                id="register-terms-link"
                class="flex items-center gap-1 text-sm"
                href="/disclaimer"
                target="_blank"
              >
                <img
                  src={termsIcon.src}
                  width={termsIcon.width}
                  height={termsIcon.height}
                  alt=""
                />
                Terms of Service
              </a>
              [[ if .Terms ]]
              <Checkbox
                id="register-terms-check"
                name="terms"
                checked
                class="text-sm"
              >
                I accept the Terms of Service
              </Checkbox>
              [[ else ]]
              <Checkbox id="register-terms-check" name="terms" class="text-sm">
                I accept the Terms of Service
              </Checkbox>
              [[ end ]]
            </div>
          </div>
        </section>

        <div id="form-validation-error-box" hidden>
          <Notice>
            Sorry, registration failed. Please check the information you gave in
            the red boxes.
          </Notice>
        </div>
      </div>
    </div>

    <div id="register-buttons" class="flex justify-between text-xs">
      <Link href="/">Exit registration</Link>

      <button
        id="register-button-continue"
        class="border-2 border-b-4 rounded border-green-900 bg-lime-600 text-white font-bold px-2 disabled:opacity-50"
        type="submit"
      >
        Done
      </button>
    </div>
  </form>

  <RegistrationForm client:only="svelte" />
</SignedOut>
