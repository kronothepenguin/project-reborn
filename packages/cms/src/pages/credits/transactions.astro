---
import { Card } from "@project-reborn/components";
import PurseBox from "../../components/credits/purse-box.astro";
import TransactionsTable from "../../components/credits/transactions-table.astro";
import Community from "../../layouts/community.astro";
---

<Community title="[[ .ShortName ]] ~ Account transactions" tab="credits" sub="">
  <div class="flex">
    <div class="w-153.5">
      <div class="mr-2.5 mb-2.5">
        <Card color="brown">
          <span slot="header">Account transactions</span>
          <TransactionsTable />
        </Card>
      </div>
    </div>
    <div class="w-103.5">
      <div class="mr-2.5 mb-2.5"><PurseBox /></div>
    </div>
  </div>
</Community>
