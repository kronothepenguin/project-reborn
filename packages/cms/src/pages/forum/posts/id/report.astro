---
import HelpTool from "../../../../layouts/help-tool.astro";

// iot/go.php answering a report: the Help Tool's text and the answer, never its
// form. Holo's Proceed link is a button that posts the report (0090), and the
// other answers have only Close. Close is the browser's own button, as Holo's
// iot styles left it.
---

<HelpTool title="[[ .ShortName ]] Help Tool">
  <form method="post" action="/forum/posts/[[ .ID ]]/report">
    <input type="hidden" name="page" value="[[ .Page ]]" />
    <table class="w-full">
      <tr>
        <td class="w-[70px] text-right align-top">
          <img class="inline" src="/iot/header_images/Western2/1.gif" alt="" width="47" height="37" />
        </td>
        <td><h2 class="pb-[5px] text-[110%] font-bold text-sky-700 uppercase">Ask your question</h2></td>
      </tr>
    </table>
    <br />
    <table class="ml-10">
      <tr>
        <td>
          <div class="mx-2.5">
            You can contact Player Support through this form. They will get back to you as soon as possible. If it's urgent,
            you may also use the Call For Help system ingame.
            <br /><br />
            <b
              >[[ .Result ]][[ if .Ask ]]<br /><br /><button type="submit" class="cursor-pointer text-orange-550 underline"
                >Proceed</button
              >[[ end ]]</b
            ><br /><br />
            <br />
          </div>
        </td>
      </tr>
    </table>
    <div class="float-right">
      <table class="h-[21px]">
        <tr>
          <td><input type="button" class="[all:revert]" value="Close" data-close /></td>
        </tr>
      </table>
    </div>
  </form>
</HelpTool>
