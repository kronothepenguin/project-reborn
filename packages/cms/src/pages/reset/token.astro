---
import { Button, Card, Input, Link, Notice } from "@project-reborn/components";
import SignedOut from "../../layouts/signed-out.astro";

// Holo has no page of its own here: it takes the forgot page's left box.
---

<SignedOut title="[[ .ShortName ]] ~ Home">
  <main class="flow-root pt-4.5">
    <div class="float-left w-1/2 pr-2">
      [[ if .Done ]]
      <Notice variant="green">Your password has been changed.</Notice>
      <p class="pt-2 pb-3 text-center"><Link href="/">Sign in &raquo;</Link></p>
      [[ else if .Invalid ]]
      <Notice>This link is invalid or has expired.</Notice>
      <p class="pt-2 pb-3 text-center">
        <Link href="/forgot">Request a new link &raquo;</Link>
      </p>
      [[ else ]]
      [[ with .Error ]]
      <div class="mb-2"><Notice>[[ . ]]</Notice></div>
      [[ end ]]
      <Card color="orange">
        <span slot="header">Choose a new password</span>

        <form method="post" class="flow-root [&_input]:w-[98%]">
          <p class="pb-3">
            <label class="block" for="reset-password">My password will be:</label>
            <Input id="reset-password" type="password" name="password" variant="border" required />
          </p>
          <p class="pb-3">
            <label class="block" for="reset-password2">Confirm password</label>
            <Input id="reset-password2" type="password" name="passwordConfirm" variant="border" required />
          </p>
          <p class="float-right pb-3">
            <Button type="submit">Save</Button>
          </p>
        </form>
      </Card>
      [[ end ]]
    </div>
  </main>
</SignedOut>
