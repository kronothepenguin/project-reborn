---
import { Paper } from "@project-reborn/components";
import workman from "../assets/maintenance/workman_habbo_down.gif";
import Document from "../layouts/document.astro";
---

<Document title="[[ .ShortName ]]">
  <main
    class="flex min-h-screen flex-col items-center justify-center gap-4 bg-cyan-950 p-2"
  >
    <Paper variant="blue">
      <figure class="flex max-w-md flex-col items-center gap-2 p-4">
        <p class="rounded-lg border border-black/20 bg-white p-3 text-sm">
          [[ .ShortName ]] could not be updated, so the website is down. Its
          administrator finds the reason in the hotel's log.
        </p>
        <img
          src={workman.src}
          width={workman.width}
          height={workman.height}
          alt="Greggers"
        />
      </figure>
    </Paper>
  </main>
</Document>
