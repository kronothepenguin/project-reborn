---
import { Button, Input } from "@project-reborn/components";
import CurrentDetails from "../../components/account/current-details.astro";
import Account from "../../layouts/account.astro";
import SettingsStep from "../../components/account/settings-step.astro";
---

<Account active="Password" heading="Change Your Password Settings">
  <form method="post" action="/account/password">
    <CurrentDetails spaced />
    <SettingsStep number={2} heading="Choose a new password" spaced>
      <p class="pb-3">Enter your new password of choice and confirm it in the second field.</p>
      <p class="pb-3 [&_input]:w-[243px]">
        <label for="password">New password:</label><br />
        <Input id="password" type="password" name="pass" maxlength="48" variant="border" />
      </p>
      <p class="pb-3 [&_input]:w-[243px]">
        <label for="confpass">Confirm new password:</label><br />
        <Input id="confpass" type="password" name="confpass" maxlength="48" variant="border" />
      </p>
    </SettingsStep>
    <div class="clear-both pt-2"><Button type="submit">Save changes</Button></div>
  </form>
</Account>
