---
import { Button, Input } from "@project-reborn/components";
import CurrentDetails from "../../components/account/current-details.astro";
import SettingsFrame from "../../components/account/settings-frame.astro";
import SettingsStep from "../../components/account/settings-step.astro";
---

<SettingsFrame active="Password" heading="Change Your Password Settings">
  <form method="post" action="/account/password" class="flex flex-col gap-2">
    <CurrentDetails />
    <SettingsStep number={2} heading="Choose a new password">
      <p>Enter your new password of choice and confirm it in the second field.</p>
      <label class="flex flex-col gap-0.5">
        <span>New password:</span>
        <Input type="password" name="pass" maxlength="48" variant="border" />
      </label>
      <label class="flex flex-col gap-0.5">
        <span>Confirm new password:</span>
        <Input type="password" name="confpass" maxlength="48" variant="border" />
      </label>
    </SettingsStep>
    <div><Button type="submit">Save changes</Button></div>
  </form>
</SettingsFrame>
