---
import { Button, Input, Link } from "@project-reborn/components";
import Account from "../../layouts/account.astro";
---

<Account active="Motto & Preferences" heading="Change Your Profile">
  <form method="post" action="/account/profile">
    <h3 class="my-1 text-xs font-bold">Your motto</h3>
    <p class="pb-3">Your motto is seen by everyone, so think carefully!</p>
    <p class="pb-3 [&_input]:w-[243px]">
      <label for="avatarmotto">Motto:</label>{" "}<Input id="avatarmotto" name="motto" value="[[ .Motto ]]" maxlength="32" variant="border" />
    </p>

    [[ if .ClubDays ]]
    <h3 class="my-1 text-xs font-bold">Club Membership</h3>
    <p class="pb-3">You are a [[ .ShortName ]] Club member. Your membership will expire in <b>[[ .ClubDays ]]</b> days. If you would like to extend your membership, please click <Link href="/club">here</Link>.</p>
    [[ end ]]

    <div class="clear-both pt-2"><Button type="submit">Save changes</Button></div>
  </form>
</Account>
