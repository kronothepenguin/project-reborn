---
import { Avatar, Card } from "@project-reborn/components";
import Community from "../layouts/community.astro";
---

<Community title="[[ .ShortName ]] ~ [[ .Habbo ]]" tab="me" sub="Homepage">
  <div class="w-72">
    <Card>
      <div class="flex flex-col items-center gap-2">
        <Avatar
          imagingUrl="[[ .ImagingURL ]]"
          figure="[[ .Figure ]]"
          alt="[[ .Habbo ]]"
        />
        <p class="font-bold">[[ .Habbo ]]</p>
      </div>
    </Card>
  </div>
</Community>
