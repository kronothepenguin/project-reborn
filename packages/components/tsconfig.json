{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "types": ["svelte", "vite/client", "node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", ".storybook/**/*.ts", "vite.config.ts"]
}