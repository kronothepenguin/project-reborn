---
import { FormField, Input, Select } from "@project-reborn/components";

// One group of the settings step, over the group in the template's dot: its
// title and its fields, each drawn by its kind.
---

<fieldset class="space-y-3 rounded border border-sky-700 p-2">
  <legend class="px-1 text-sm font-bold">[[ .Title ]]</legend>
  [[ range .Fields ]] [[ if eq .Kind "switch" ]]
  <div class="flex flex-col gap-1 text-sm">
    <input type="hidden" name="[[ .Key ]]" value="0" />
    <label class="flex items-center gap-2">
      [[ if .On ]]
      <input type="checkbox" name="[[ .Key ]]" value="1" checked />
      [[ else ]]
      <input type="checkbox" name="[[ .Key ]]" value="1" />
      [[ end ]]
      <span>[[ .Label ]]</span>
    </label>
    [[ if .Help ]]<span>[[ .Help ]]</span>[[ end ]]
  </div>
  [[ else ]]
  <FormField
    label="[[ .Label ]]"
    help="[[ .Help ]]"
    class="flex flex-col gap-1 text-sm"
  >
    [[ if eq .Kind "longtext" ]]
    <textarea
      name="[[ .Key ]]"
      rows="5"
      class="border border-neutral-600 bg-white p-0.5 text-black">[[ .Value ]]</textarea
    >
    [[ else if eq .Kind "choice" ]]
    <Select name="[[ .Key ]]">
      [[ range .Choices ]][[ if .Selected ]]
      <option value="[[ .Value ]]" selected>[[ .Label ]]</option>
      [[ else ]]
      <option value="[[ .Value ]]">[[ .Label ]]</option>
      [[ end ]][[ end ]]
    </Select>
    [[ else if eq .Kind "number" ]]
    <Input name="[[ .Key ]]" type="number" value="[[ .Value ]]" variant="border" />
    [[ else if eq .Kind "password" ]]
    <Input
      name="[[ .Key ]]"
      type="password"
      autocomplete="new-password"
      variant="border"
    />
    [[ else ]]
    <Input name="[[ .Key ]]" value="[[ .Value ]]" variant="border" />
    [[ end ]]
  </FormField>
  [[ end ]] [[ end ]]
</fieldset>
