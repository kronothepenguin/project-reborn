---
import SettingsGroup from "./settings-group.astro";

// "More settings": the groups in the template's .More, folded unless open.
interface Props {
  open?: boolean;
}

const { open = false } = Astro.props;
---

<details class="group" open={open}>
  <summary class="cursor-pointer font-bold text-blue-900 hover:underline">More settings</summary>
  <div class="mt-4 gap-4 lg:columns-2 [&>fieldset]:mb-4 [&>fieldset]:break-inside-avoid">
    [[ range .More ]]<SettingsGroup />[[ end ]]
  </div>
</details>
