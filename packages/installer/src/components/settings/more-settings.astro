---
import MoreGroup from "./more-group.astro";
import SettingsSection from "./settings-section.astro";

// "More settings": the last section, over the groups in the template's .More,
// each an inner section. The group a refused form names opens.
interface Props {
  open?: boolean;
}

const { open = false } = Astro.props;
---

<SettingsSection title="More settings" open={open}>
  <div class="-mt-2 flex flex-col">
    [[ range .More ]][[ if .Refused ]]<MoreGroup open />[[ else ]]<MoreGroup />[[ end ]][[ end ]]
  </div>
</SettingsSection>
