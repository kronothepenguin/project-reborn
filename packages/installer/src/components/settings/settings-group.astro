---
import SettingsFields from "./settings-fields.astro";

// One group of the settings step, over the group in the template's dot: its
// title and its fields. It is a panel of the step's tabs; with scripts off it
// shows framed, under the group before it.
---

<fieldset
  data-tab="[[ .Title ]]"
  data-refused="[[ .Refused ]]"
  class="flex min-w-0 flex-col gap-3 rounded border border-sky-600 px-3 pt-1 pb-3 group-data-tabbed/settings:border-0 group-data-tabbed/settings:p-0"
>
  <legend class="px-1 font-bold text-sky-700 group-data-tabbed/settings:sr-only">[[ .Title ]]</legend>
  <SettingsFields />
</fieldset>
