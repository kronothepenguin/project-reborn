---
import SettingsFields from "./settings-fields.astro";
import SettingsSection from "./settings-section.astro";

// One group under "More settings", over the group in the template's dot: an
// inner section with its title and its fields.
interface Props {
  open?: boolean;
}

const { open = false } = Astro.props;
---

<SettingsSection title="[[ .Title ]]" open={open} level="inner">
  <SettingsFields />
</SettingsSection>
