---
import { Card } from "@project-reborn/components";
import logo from "../assets/habbo.png";
import StepTabs from "../components/step-tabs.svelte";
import Document from "./document.astro";

type Step = "status" | "config" | "site" | "settings" | "client" | "admin";

// The installer's page: the hotel's logo over one box, whose blue title bar
// names the step and whose first row is the steps as tabs. A wide step, such as
// the settings, takes the box's whole width; the others keep a column.
interface Props {
  title: string;
  step: Step;
  wide?: boolean;
}

const { title, step, wide = false } = Astro.props;
---

<Document title={`${title} - Project Reborn installer`}>
  <div class="mx-auto w-full max-w-240 px-4 py-8">
    <header class="mb-4 flex flex-wrap items-end gap-x-4 gap-y-2">
      <img src={logo.src} width={logo.width} height={logo.height} alt="Habbo Hotel" />
      <h1 class="text-2xl font-bold text-blue-900">Project Reborn installer</h1>
    </header>
    <main>
      <Card color="blue">
        <h2 slot="header">{title}</h2>
        <div class="space-y-4">
          <div class="min-h-8">
            <StepTabs client:only="svelte" current={step} waiting="[[ .Waiting ]]" />
          </div>
          <div class:list={["space-y-4 pb-2", !wide && "max-w-2xl"]}>
            <slot />
          </div>
        </div>
      </Card>
    </main>
  </div>
</Document>
