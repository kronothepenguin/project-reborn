---
import { Button, Checkbox, FormField, Input } from "@project-reborn/components";
import FormError from "../components/form-error.astro";
import Setup from "../layouts/setup.astro";
---

<Setup title="Administrator" step="admin">
  <p>
    Creates your user, your first habbo and Reborn's staff ranks as access groups.
    You join Administrator, which holds every attribute.
  </p>
  <FormError />
  <form method="post" action="/installer/admin" class="space-y-3">
    <FormField
      label="Habbo name"
      help="1 to 24 letters, digits or - = ? ! @ : . ,"
      class="flex flex-col gap-1"
    >
      <Input
        name="name"
        value="[[ .Name ]]"
        maxlength="24"
        variant="border"
        required
      />
    </FormField>
    <FormField label="Email" class="flex flex-col gap-1">
      <Input
        name="email"
        type="email"
        value="[[ .Email ]]"
        variant="border"
        required
      />
    </FormField>
    <FormField label="Birth date" class="flex flex-col gap-1">
      <Input
        name="bornOn"
        type="date"
        value="[[ .BornOn ]]"
        variant="border"
        required
      />
    </FormField>
    <FormField
      label="Password"
      help="[[ .PasswordHelp ]]"
      class="flex flex-col gap-1"
    >
      <Input name="password" type="password" variant="border" required />
    </FormField>
    <FormField label="Confirm password" class="flex flex-col gap-1">
      <Input
        name="passwordConfirm"
        type="password"
        variant="border"
        required
      />
    </FormField>
    [[ if .Club ]]
    <Checkbox name="club" value="on" checked>Give this habbo Habbo Club</Checkbox>
    [[ else ]]
    <Checkbox name="club" value="on">Give this habbo Habbo Club</Checkbox>
    [[ end ]]
    <FormField
      label="Credits"
      help="Habbos who register get the start credits of the site step."
      class="flex flex-col gap-1"
    >
      <Input
        name="credits"
        type="number"
        min="0"
        max="1000000"
        value="[[ .Credits ]]"
        variant="border"
        required
      />
    </FormField>
    <div class="flex justify-end">
      <Button type="submit" variant="green">Create administrator</Button>
    </div>
  </form>
</Setup>
