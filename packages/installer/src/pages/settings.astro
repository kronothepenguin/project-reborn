---
import { Button } from "@project-reborn/components";
import FormError from "../components/form-error.astro";
import MoreSettings from "../components/settings/more-settings.astro";
import SettingsGroup from "../components/settings/settings-group.astro";
import StepButtons from "../components/step-buttons.astro";
import Setup from "../layouts/setup.astro";
---

<Setup title="Settings" step="settings">
  <p>
    Set what your hotel needs on its first day. Skip keeps every setting as
    it is, and housekeeping changes them later.
  </p>
  <FormError />
  <form method="post" action="/installer/settings" class="flex flex-col gap-3">
    {/*
      Every group is a section, and a closed one stays in the form. The first
      opens, or the group of a refused field, and "More settings" when one of
      its groups holds that field.
    */}
    <div id="settings-sections" class="flex flex-col gap-1.5">
      [[ $refused := false ]][[ $more := false ]]
      [[ range .Open ]][[ if .Refused ]][[ $refused = true ]][[ end ]][[ end ]]
      [[ range .More ]][[ if .Refused ]][[ $refused = true ]][[ $more = true ]][[ end ]][[ end ]]
      [[ range $i, $group := .Open ]][[ if or .Refused (and (eq $i 0) (not $refused)) ]]<SettingsGroup open />[[ else ]]<SettingsGroup />[[ end ]][[ end ]]
      [[ if $more ]]<MoreSettings open />[[ else ]]<MoreSettings />[[ end ]]
    </div>
    <StepButtons>
      <Button type="submit" name="action" value="save" variant="green"
        >Save settings</Button
      >
      <Button type="submit" name="action" value="skip">Skip</Button>
    </StepButtons>
  </form>
</Setup>
