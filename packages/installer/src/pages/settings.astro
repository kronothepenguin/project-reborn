---
import { Button } from "@project-reborn/components";
import FormError from "../components/form-error.astro";
import MoreSettings from "../components/more-settings.astro";
import SettingsGroup from "../components/settings-group.astro";
import Setup from "../layouts/setup.astro";
---

<Setup title="Settings" step="settings" wide>
  <p>
    Set what your hotel needs on its first day. Skip keeps every setting as
    it is, and housekeeping changes them later.
  </p>
  <FormError />
  <form method="post" action="/installer/settings" class="space-y-4">
    <div class="gap-4 lg:columns-2 [&>fieldset]:mb-4 [&>fieldset]:break-inside-avoid">
      [[ range .Open ]]<SettingsGroup />[[ end ]]
    </div>
    {/* A refused form shows every field, so that the one it names is in sight. */}
    [[ if .Error ]]<MoreSettings open />[[ else ]]<MoreSettings />[[ end ]]
    <div class="flex flex-row-reverse justify-start gap-2">
      <Button type="submit" name="action" value="save" variant="green"
        >Save settings</Button
      >
      <Button type="submit" name="action" value="skip">Skip</Button>
    </div>
  </form>
</Setup>
