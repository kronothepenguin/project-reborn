---
import { Button, FormField, Input, Link } from "@project-reborn/components";
import FormError from "../components/form-error.astro";
import Setup from "../layouts/setup.astro";
---

<Setup title="Configuration" step="config">
  [[ if .Written ]]
  <p class="text-sm">
    <span class="font-mono break-all">[[ .ConfigPath ]]</span> is written: the database
    is <span class="font-mono break-all">[[ .Path ]]</span> and the hotel listens
    on port [[ .Port ]].
  </p>
  <div class="flex justify-end text-sm">
    <Link href="/site">Continue</Link>
  </div>
  [[ else ]]
  <FormError />
  <form method="post" action="/config" class="space-y-3">
    <FormField
      label="Database file"
      help="Relative to the directory the hotel runs from."
      class="flex flex-col gap-1 text-sm"
    >
      <Input name="path" value="[[ .Path ]]" variant="border" required />
    </FormField>
    <FormField label="Hotel port" class="flex flex-col gap-1 text-sm">
      <Input
        name="port"
        type="number"
        min="1"
        max="65535"
        value="[[ .Port ]]"
        variant="border"
        required
      />
    </FormField>
    <div class="flex justify-end">
      <Button type="submit" variant="green">Write configuration</Button>
    </div>
  </form>
  [[ end ]]
</Setup>
