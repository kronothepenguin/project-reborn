---
import { Button, FormField, Input, Link } from "@project-reborn/components";
import FormError from "../components/form-error.astro";
import Setup from "../layouts/setup.astro";
---

<Setup title="Configuration" step="config">
  [[ if .Written ]]
  <FormError />
  <p class="text-sm">
    <span class="font-mono break-all">[[ .ConfigPath ]]</span> is written: the database
    is <span class="font-mono break-all">[[ .Path ]]</span>, the hotel listens on port
    [[ .Port ]] and housekeeping on port [[ .HousekeepingPort ]].
  </p>
  <div class="flex justify-end text-sm">
    <Link href="/installer/site">Continue</Link>
  </div>
  [[ else ]]
  <FormError />
  <form method="post" action="/installer/config" class="space-y-3">
    [[ if .OneAddress ]]
    <p class="text-sm">
      The database is <span class="font-mono break-all">[[ .Path ]]</span>, as
      <span class="font-mono break-all">[[ .ConfigPath ]]</span> names it.
    </p>
    <FormField
      label="Hotel host"
      help="0.0.0.0 listens on every interface."
      class="flex flex-col gap-1 text-sm"
    >
      <Input name="host" value="[[ .Host ]]" variant="border" required />
    </FormField>
    [[ else ]]
    <FormField
      label="Database file"
      help="Relative to the directory the hotel runs from."
      class="flex flex-col gap-1 text-sm"
    >
      <Input name="path" value="[[ .Path ]]" variant="border" required />
    </FormField>
    [[ end ]]
    <FormField label="Hotel port" class="flex flex-col gap-1 text-sm">
      <Input
        name="port"
        type="number"
        min="1"
        max="65535"
        value="[[ .Port ]]"
        variant="border"
        required
      />
    </FormField>
    [[ if not .OneAddress ]]
    <FormField label="Housekeeping port" class="flex flex-col gap-1 text-sm">
      <Input
        name="housekeepingPort"
        type="number"
        min="1"
        max="65535"
        value="[[ .HousekeepingPort ]]"
        variant="border"
        required
      />
    </FormField>
    [[ end ]]
    <div class="flex justify-end">
      <Button type="submit" variant="green"
        >[[ if .OneAddress ]]Save address[[ else ]]Write configuration[[ end ]]</Button
      >
    </div>
  </form>
  [[ end ]]
</Setup>
