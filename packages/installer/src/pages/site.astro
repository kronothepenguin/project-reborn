---
import { Button, Checkbox, FormField, Input } from "@project-reborn/components";
import FormError from "../components/form-error.astro";
import Setup from "../layouts/setup.astro";
---

<Setup title="Site" step="site">
  <FormError />
  <form method="post" action="/installer/site" class="space-y-3">
    <FormField label="Site name" class="flex flex-col gap-1">
      <Input
        name="name"
        value="[[ .Name ]]"
        maxlength="30"
        variant="border"
        required
      />
    </FormField>
    <FormField label="Short name" class="flex flex-col gap-1">
      <Input
        name="shortName"
        value="[[ .ShortName ]]"
        maxlength="30"
        variant="border"
        required
      />
    </FormField>
    <FormField
      label="Site URL"
      help="The address players open, without a path."
      class="flex flex-col gap-1"
    >
      <Input
        name="url"
        type="url"
        value="[[ .URL ]]"
        variant="border"
        required
      />
    </FormField>
    [[ if not .OneAddress ]]
    <FormField
      label="Housekeeping address"
      help="Where the site's Housekeeping links lead."
      class="flex flex-col gap-1"
    >
      <Input
        name="housekeepingUrl"
        value="[[ .HousekeepingURL ]]"
        variant="border"
        required
      />
    </FormField>
    [[ end ]]
    <FormField
      label="Start credits"
      help="Credits every new habbo receives."
      class="flex flex-col gap-1"
    >
      <Input
        name="startCredits"
        type="number"
        min="0"
        max="1000000"
        value="[[ .StartCredits ]]"
        variant="border"
        required
      />
    </FormField>
    [[ if .SecureCookies ]]
    <Checkbox name="secureCookies" value="on" checked
      >Secure cookies: the site is served over HTTPS</Checkbox
    >
    [[ else ]]
    <Checkbox name="secureCookies" value="on"
      >Secure cookies: the site is served over HTTPS</Checkbox
    >
    [[ end ]]
    <div class="flex justify-end">
      <Button type="submit" variant="green">Save and continue</Button>
    </div>
  </form>
</Setup>
