---
import { Button } from "@project-reborn/components";
import StepButtons from "../components/step-buttons.astro";
import Setup from "../layouts/setup.astro";
---

<Setup title="Welcome" step="status">
  [[ if .Installed ]]
  <p>
    This hotel is already installed: <span class="font-mono break-all"
      >[[ .ConfigPath ]]</span
    > exists and its database has an administrator. The installer has nothing
    left to do.
  </p>
  <StepButtons>
    <Button href="[[ .SiteURL ]]" variant="green">Go to the hotel</Button>
  </StepButtons>
  [[ else ]]
  <p>
    The installer writes <span class="font-mono break-all"
      >[[ .ConfigPath ]]</span
    >, creates the database it names, saves the site settings, saves more
    settings and imports the client files when you choose, and creates the first
    administrator. Run the hotel from the same directory afterwards.
  </p>
  <StepButtons>
    [[ if .Configured ]]
    <Button href="/installer/[[ .Next ]]" variant="green">Continue</Button>
    [[ else ]]
    <Button href="/installer/config" variant="green">Start</Button>
    [[ end ]]
  </StepButtons>
  [[ end ]]
</Setup>
