---
import { Box, Button, Table } from "@project-reborn/components";
import Message from "../../components/message.astro";
import NewsFields from "../../components/news/news-fields.astro";
import Housekeeping from "../../layouts/housekeeping.astro";
---

<Housekeeping title="Manage Existing Articles" tab="site">
  <Message />
  <p class="mb-2"><a href="[[ .SiteURL ]]/news/[[ .ID ]]" class="text-indigo-900 underline">View on site</a></p>
  <form method="post" action="/housekeeping/news/[[ .ID ]]">
    <Box title="Edit News Article ([[ .Title ]])">
      <Table variant="form">
        <tbody>
          <NewsFields />
        </tbody>
      </Table>
      <div class="border-t-2 border-black bg-olive-200 p-1 text-center">
        <Button variant="plain" size="compact" type="submit">Update Article</Button>
      </div>
    </Box>
  </form>
</Housekeeping>
