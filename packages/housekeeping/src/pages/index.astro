---
import { Box, Button, Table } from "@project-reborn/components";
import Housekeeping from "../layouts/housekeeping.astro";
---

<Housekeeping title="Dashboard" tab="dashboard">
  <h1 class="font-sans text-2xl font-bold">Project Reborn Housekeeping</h1>
  <div class="mt-2.5 grid gap-4 lg:grid-cols-2">
    <Box title="System Overview" color="gold">
      <Table>
        <tbody>
          <tr>
            <td><strong>Members</strong></td>
            <td>[[ .Habbos ]] (<a href="/housekeeping/online" class="text-indigo-900 underline">[[ .Online ]]</a> online)</td>
          </tr>
          <tr>
            <td><strong>Rooms</strong></td>
            <td>[[ .Rooms ]] (of which [[ .PublicRooms ]] public rooms)</td>
          </tr>
          <tr>
            <td><strong>Furniture</strong></td>
            <td>[[ .Furni ]]</td>
          </tr>
          <tr>
            <td><strong>Groups</strong></td>
            <td>[[ .Groups ]]</td>
          </tr>
          <tr>
            <td><strong>Stafflog Entries</strong></td>
            <td>[[ .StaffLogs ]]</td>
          </tr>
          <tr>
            <td><strong>Active Bans</strong></td>
            <td>[[ .ActiveBans ]]</td>
          </tr>
        </tbody>
      </Table>
    </Box>
    <Box title="[[ .SiteName ]] Administrators" color="gold">
      <Table>
        <tbody>
          [[ range .Administrators ]]
          <tr>
            <td><strong>[[ .Name ]]</strong> (ID: [[ .ID ]])</td>
            <td>[[ if .Email ]]<a href="mailto:[[ .Email ]]" class="text-indigo-900 underline">[[ .Email ]]</a>[[ end ]]</td>
          </tr>
          [[ end ]]
        </tbody>
      </Table>
    </Box>
  </div>
  <div class="mt-4">
    <Box title="Housekeeping Notes">
      <form method="post" action="/housekeeping/note" class="space-y-2.5 p-2.5 text-center">
        <textarea
          name="notes"
          rows="8"
          aria-label="Housekeeping Notes"
          class="w-full border border-neutral-300 bg-yellow-200 p-1.5"
        >[[ .Note ]]</textarea>
        <Button variant="plain" size="compact" type="submit">Save Admin Notes</Button>
      </form>
    </Box>
  </div>
</Housekeeping>
