---
import { Input, Table } from "@project-reborn/components";
import Box from "../components/box.astro";
import Message from "../components/message.astro";
import Submit from "../components/submit.astro";
import Housekeeping from "../layouts/housekeeping.astro";
---

<Housekeeping title="Alert" tab="users">
  <Message />
  <div class="space-y-3">
    <form method="post" action="/housekeeping/alerts">
      <Box title="Alert User">
        <Table variant="form">
          <tbody>
            <tr>
              <td class="w-2/5">
                <label for="alert-username"><strong>Username</strong></label>
                <div class="text-neutral-500">The name of the user you want to give this alert to.</div>
              </td>
              <td class="w-3/5"><Input id="alert-username" name="username" value="[[ .Username ]]" variant="border" /></td>
            </tr>
            <tr>
              <td>
                <label for="alert-text"><strong>Alert</strong></label>
                <div class="text-neutral-500">The actual message that will be shown to the user.</div>
              </td>
              <td>
                <textarea id="alert-text" name="alert" rows="5" class="w-full border border-neutral-600 bg-white p-1">[[ .Alert ]]</textarea>
              </td>
            </tr>
          </tbody>
        </Table>
        <div class="border-t-2 border-black bg-olive-200 p-1 text-center">
          <Submit>Give Alert</Submit>
        </div>
      </Box>
    </form>

    [[ if .CanBroadcast ]]
    <form method="post" action="/housekeeping/alerts">
      <Box title="Mass Site Alert">
        <Table variant="form">
          <tbody>
            <tr>
              <td class="w-2/5">
                <label for="alert-everyone"><strong>Alert</strong></label>
                <div class="text-neutral-500">The actual message that will be shown to the user.</div>
              </td>
              <td class="w-3/5">
                <textarea id="alert-everyone" name="everyone" rows="5" class="w-full border border-neutral-600 bg-white p-1">[[ .Everyone ]]</textarea>
              </td>
            </tr>
          </tbody>
        </Table>
        <div class="border-t-2 border-black bg-olive-200 p-1 text-center">
          <Submit>Give Alert</Submit>
        </div>
      </Box>
    </form>
    [[ end ]]

    <Box title="Active Alerts Listing" color="gold">
      <Table>
        <thead>
          <tr>
            <th>ID</th>
            <th>User</th>
            <th>Alert</th>
            <th>Type</th>
          </tr>
        </thead>
        <tbody>
          [[ range .Alerts ]]
          <tr>
            <td>[[ .ID ]]</td>
            <td>[[ .Habbo ]] (ID: [[ .HabboID ]])</td>
            <td class="whitespace-pre-line">[[ .Alert ]]</td>
            <td>[[ .Type ]]</td>
          </tr>
          [[ else ]]
          <tr>
            <td colspan="4">Nothing found.</td>
          </tr>
          [[ end ]]
        </tbody>
      </Table>
    </Box>
    <p class="text-center">[[ if .Newer ]]<a href="/housekeeping/alerts?page=[[ .Newer ]]" class="text-indigo-900 underline">Newer</a>[[ end ]] [[ if .Older ]]<a href="/housekeeping/alerts?page=[[ .Older ]]" class="text-indigo-900 underline">Older</a>[[ end ]]</p>
  </div>
</Housekeeping>
