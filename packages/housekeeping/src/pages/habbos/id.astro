---
import { Checkbox, Input, Select, Table } from "@project-reborn/components";
import Box from "../../components/box.astro";
import Message from "../../components/message.astro";
import Submit from "../../components/submit.astro";
import Housekeeping from "../../layouts/housekeeping.astro";
---

<Housekeeping title="[[ .Target.Name ]]" tab="users">
  <Message />
  <div class="space-y-3">
    <form method="post" action="/housekeeping/habbos/[[ .Target.ID ]]">
      <Box title="[[ .Target.Name ]] (ID: [[ .Target.ID ]])[[ if .Target.Archived ]] - Archived[[ end ]]">
        <Table variant="form">
          <tbody>
            [[ if .CanEdit ]]
            <tr>
              <td class="w-2/5"><label for="habbo-motto"><strong>Motto</strong></label></td>
              <td class="w-3/5"><Input id="habbo-motto" name="motto" value="[[ .Target.Motto ]]" variant="border" /></td>
            </tr>
            <tr>
              <td><label for="habbo-figure"><strong>Figure</strong></label></td>
              <td><Input id="habbo-figure" name="figure" value="[[ .Target.Figure ]]" variant="border" /></td>
            </tr>
            <tr>
              <td><label for="habbo-gender"><strong>Gender</strong></label></td>
              <td>
                <Select id="habbo-gender" name="gender">
                  [[ if eq .Target.Gender "F" ]]
                  <option value="M">M</option>
                  <option value="F" selected>F</option>
                  [[ else ]]
                  <option value="M" selected>M</option>
                  <option value="F">F</option>
                  [[ end ]]
                </Select>
              </td>
            </tr>
            [[ else ]]
            <tr><td class="w-2/5"><strong>Motto</strong></td><td class="w-3/5">[[ .Target.Motto ]]</td></tr>
            <tr><td><strong>Figure</strong></td><td class="break-all">[[ .Target.Figure ]]</td></tr>
            <tr><td><strong>Gender</strong></td><td>[[ .Target.Gender ]]</td></tr>
            [[ end ]]
            <tr><td class="w-2/5"><strong>Join date</strong></td><td class="w-3/5">[[ .Target.Joined ]]</td></tr>
            <tr><td><strong>Last Activity</strong></td><td>[[ .Target.Activity ]]</td></tr>
          </tbody>
        </Table>
        [[ if .CanEdit ]]
        <div class="border-t-2 border-black bg-olive-200 p-1 text-center">
          <Submit>Save Habbo</Submit>
        </div>
        [[ end ]]
      </Box>
    </form>

    <form method="post" action="/housekeeping/users/[[ .Owner.ID ]]">
      <input type="hidden" name="habbo" value="[[ .Target.ID ]]" />
      <Box title="Owner (User ID: [[ .Owner.ID ]])">
        <Table variant="form">
          <tbody>
            [[ if and .Private .CanEdit ]]
            <tr>
              <td class="w-2/5"><label for="user-email"><strong>E-Mail Address</strong></label></td>
              <td class="w-3/5"><Input id="user-email" name="email" value="[[ .Owner.Email ]]" variant="border" /></td>
            </tr>
            <tr>
              <td><label for="user-born-on"><strong>Birthdate</strong></label></td>
              <td><Input id="user-born-on" type="date" name="bornOn" value="[[ .Owner.BornOn ]]" variant="border" /></td>
            </tr>
            [[ else if .Private ]]
            <tr><td class="w-2/5"><strong>E-Mail Address</strong></td><td class="w-3/5">[[ .Owner.Email ]]</td></tr>
            <tr><td><strong>Birthdate</strong></td><td>[[ .Owner.BornOn ]]</td></tr>
            [[ end ]]
            <tr>
              <td class="w-2/5"><strong>Credits</strong></td>
              <td class="w-3/5">
                [[ .Owner.Credits ]]
                [[ if .CanGive ]]
                [<a href="/housekeeping/habbos/[[ .Target.ID ]]/transactions" class="text-indigo-900 underline">Transaction logs</a>]
                [[ end ]]
              </td>
            </tr>
            [[ if .CanEdit ]]
            <tr>
              <td><label for="user-tickets"><strong>Tickets</strong></label></td>
              <td><Input id="user-tickets" name="tickets" value="[[ .Owner.Tickets ]]" variant="border" /></td>
            </tr>
            <tr>
              <td><label for="user-film"><strong>Film</strong></label></td>
              <td><Input id="user-film" name="film" value="[[ .Owner.Film ]]" variant="border" /></td>
            </tr>
            <tr>
              <td><strong>Newsletter</strong></td>
              <td>
                [[ if .Owner.Newsletter ]]
                <Checkbox name="newsletter" value="1" checked>Newsletter</Checkbox>
                [[ else ]]
                <Checkbox name="newsletter" value="1">Newsletter</Checkbox>
                [[ end ]]
              </td>
            </tr>
            [[ else ]]
            <tr><td><strong>Tickets</strong></td><td>[[ .Owner.Tickets ]]</td></tr>
            <tr><td><strong>Film</strong></td><td>[[ .Owner.Film ]]</td></tr>
            <tr><td><strong>Newsletter</strong></td><td>[[ if .Owner.Newsletter ]]Yes[[ else ]]No[[ end ]]</td></tr>
            [[ end ]]
          </tbody>
        </Table>
        [[ if .CanEdit ]]
        <div class="border-t-2 border-black bg-olive-200 p-1 text-center">
          <Submit>Save User</Submit>
        </div>
        [[ end ]]
        [[ if .CanBan ]]
        <p class="border-t-2 border-black p-1 text-center">
          <a href="/housekeeping/bans?user=[[ .Target.Name ]]" class="text-indigo-900 underline">Ban this user</a>
        </p>
        [[ end ]]
      </Box>
    </form>

    [[ if .CanGive ]]
    <form method="post" action="/housekeeping/habbos/[[ .Target.ID ]]/credits">
      <Box title="Give Credits / Refunds">
        <Table variant="form">
          <tbody>
            <tr>
              <td class="w-2/5">
                <label for="credits-amount"><strong>Amount</strong></label>
                <div class="text-neutral-500">The amount of credits you want to give.</div>
              </td>
              <td class="w-3/5"><Input id="credits-amount" name="amount" variant="border" /></td>
            </tr>
          </tbody>
        </Table>
        <div class="border-t-2 border-black bg-olive-200 p-1 text-center">
          <Submit>Give Credits</Submit>
        </div>
      </Box>
    </form>
    [[ end ]]

    <Box title="Badges" color="gold">
      <Table>
        <thead>
          <tr>
            <th>Badge</th>
            <th>Current</th>
            [[ if .CanEdit ]]<th>Remove</th>[[ end ]]
          </tr>
        </thead>
        <tbody>
          [[ range .Badges ]]
          <tr>
            <td>[[ .Code ]]</td>
            <td>[[ if .Worn ]]Yes[[ else ]]No[[ end ]]</td>
            [[ if $.CanEdit ]]
            <td>
              <form method="post" action="/housekeeping/habbos/[[ $.Target.ID ]]/badges/[[ .Code ]]/delete">
                <Submit>Remove</Submit>
              </form>
            </td>
            [[ end ]]
          </tr>
          [[ else ]]
          <tr>
            <td colspan="3">This habbo has no badges.</td>
          </tr>
          [[ end ]]
        </tbody>
      </Table>
    </Box>

    [[ if .CanEdit ]]
    <form method="post" action="/housekeeping/habbos/[[ .Target.ID ]]/badges">
      <Box title="Badge Manager">
        <Table variant="form">
          <tbody>
            <tr>
              <td class="w-2/5">
                <label for="badge-code"><strong>Badgecode</strong></label>
                <div class="text-neutral-500">The bage code, eg. 'ADM' or 'XM8'.</div>
              </td>
              <td class="w-3/5"><Input id="badge-code" name="badge" variant="border" /></td>
            </tr>
          </tbody>
        </Table>
        <div class="border-t-2 border-black bg-olive-200 p-1 text-center">
          <Submit>Give badge</Submit>
        </div>
      </Box>
    </form>
    [[ end ]]

    <Box title="The Owner's Other Habbos" color="gold">
      <Table>
        <tbody>
          [[ range .Others ]]
          <tr>
            <td><a href="/housekeeping/habbos/[[ .ID ]]" class="text-indigo-900 underline">[[ .Name ]]</a>[[ if .Archived ]] (Archived)[[ end ]]</td>
          </tr>
          [[ else ]]
          <tr>
            <td>This user has no other habbos.</td>
          </tr>
          [[ end ]]
        </tbody>
      </Table>
    </Box>

    [[ if .Private ]]
    <Box title="IP History" color="gold">
      <Table>
        <thead>
          <tr>
            <th>IP Address</th>
            <th>Last sign-in</th>
          </tr>
        </thead>
        <tbody>
          [[ range .Logins ]]
          <tr>
            <td>
              <a href="/housekeeping/habbos?q=[[ .IP ]]" class="text-indigo-900 underline">[[ .IP ]]</a>
              [<a href="https://who.is/whois-ip/ip-address/[[ .IP ]]/" target="_blank" rel="noreferrer" class="text-indigo-900 underline">WHOIS</a>]
            </td>
            <td>[[ .Date ]]</td>
          </tr>
          [[ else ]]
          <tr>
            <td colspan="2">No IP Found</td>
          </tr>
          [[ end ]]
        </tbody>
      </Table>
    </Box>
    [[ end ]]
  </div>
</Housekeeping>
