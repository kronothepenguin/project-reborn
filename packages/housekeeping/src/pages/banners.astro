---
import { Box, Button, Table } from "@project-reborn/components";
import BannerAnswer from "../components/banners/banner-answer.astro";
import BannerFields from "../components/banners/banner-fields.astro";
import Housekeeping from "../layouts/housekeeping.astro";
---

<Housekeeping title="Manage Site Banners" tab="site">
  <div class="space-y-4">
    <form method="post" action="/housekeeping/banners">
      <Box title="Add banners">
        <Table variant="form">
          <tbody>
            <BannerAnswer />
            <tr>
              <td class="w-2/5"><strong>Add or edit banners on your site!</strong></td>
              <td class="w-3/5">You're already finished in 1 minute!</td>
            </tr>
            <BannerFields />
          </tbody>
        </Table>
        <div class="border-t-2 border-black bg-olive-200 p-1.5 text-center">
          <Button variant="plain" size="compact" type="submit">Add banner</Button>
        </div>
      </Box>
    </form>

    <Box title="Banner editer" color="gold">
      <Table>
        <tbody>
          [[ if .ListMessage ]]
          <tr>
            <td class="w-2/5"><strong role="status">[[ .ListMessage ]]</strong></td>
            <td class="w-3/5"></td>
          </tr>
          [[ end ]] [[ if .ListError ]]
          <tr>
            <td class="w-2/5 text-red-600"><strong role="alert">[[ .ListError ]]</strong></td>
            <td class="w-3/5"></td>
          </tr>
          [[ end ]] [[ range .Banners ]]
          <tr>
            <td class="w-2/5 wrap-anywhere">
              <strong>Text</strong><br />[[ .Text ]]<br />
              <strong>Banner url</strong><br />[[ .Banner ]]<br />
              <strong>Linking url</strong><br />[[ .URL ]]<br />
              <strong>Status</strong><br />[[ if .Enabled ]]Enabled![[ else ]]Disabled[[ end ]]
            </td>
            <td class="w-3/5 text-center align-middle">
              <a href="/housekeeping/banners/[[ .ID ]]" class="text-indigo-900 underline">Edit this banner!</a><br />
              <a href="/housekeeping/banners/[[ .ID ]]/delete" class="text-indigo-900 underline">Delete this banner!</a>
            </td>
          </tr>
          [[ else ]]
          <tr>
            <td colspan="2">Nothing found.</td>
          </tr>
          [[ end ]]
        </tbody>
      </Table>
    </Box>
  </div>
</Housekeeping>
