---
import Document from "../layouts/document.astro";
---

<Document title="[[ .SiteName ]] Housekeeping">
  <main class="mx-auto mt-8 max-w-md border-2 border-black">
    <h1 class="border-b-2 border-black bg-sky-700 px-0.5 font-bold text-white">
      Database Updates
    </h1>
    <p class="px-1 py-0.5">
      [[ .SiteName ]] could not be updated, so housekeeping is closed. Its
      administrator finds the reason in the hotel's log.
    </p>
  </main>
</Document>
