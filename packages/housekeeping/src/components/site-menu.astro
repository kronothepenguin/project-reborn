---
import Box from "./box.astro";
import MenuLink from "./menu-link.astro";
---

<Box title="Configuration & Setup">
  <ul>
    [[ range .Sections ]][[ if not .Content ]]
    <MenuLink href="/housekeeping/settings?section=[[ .ID ]]">[[ .Menu ]]</MenuLink>
    [[ end ]][[ end ]]
    <MenuLink href="/housekeeping/updates">Database updates</MenuLink>
  </ul>
</Box>
<Box title="Content Management">
  <ul>
    [[ range .Sections ]][[ if .Content ]]
    <MenuLink href="/housekeeping/settings?section=[[ .ID ]]">[[ .Menu ]]</MenuLink>
    [[ end ]][[ end ]]
    <MenuLink href="/housekeeping/banners">Manage Site Banners</MenuLink>
    <MenuLink href="/housekeeping/home-store">Add stickers or backgrounds to homes catalogue</MenuLink>
    <MenuLink href="/housekeeping/news/new">Compose News Item</MenuLink>
    <MenuLink href="/housekeeping/news">Manage Existing News Items</MenuLink>
  </ul>
</Box>
