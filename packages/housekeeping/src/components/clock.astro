---
import ClockTime from "./clock-time.svelte";

// The server's date and time from Go stand in the server line until the island
// takes over and ticks.
---

<div id="clock" class="border-2 border-black p-1.5 text-neutral-500">
  <strong>Local time:</strong>
  <ClockTime client:only="svelte" />
  <strong class="mt-2.5 block">Server time:</strong>
  <p>[[ .ServerName ]]</p>
  <ClockTime client:only="svelte" now="[[ .ServerMillis ]]">
    <Fragment slot="fallback">
      <p id="clock-server-date">[[ .ServerDate ]]</p>
      <p id="clock-server-time">[[ .ServerTime ]]</p>
    </Fragment>
  </ClockTime>
</div>
